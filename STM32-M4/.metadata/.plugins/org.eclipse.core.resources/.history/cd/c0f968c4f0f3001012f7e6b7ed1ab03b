#include "i2c.h"

// Note: I2C Header defines GPIOB struct pointer, so we use GPIOB here directly
void I2C1_Init(void) {
    // 1. Enable Clocks
    I2C1_EN();
    RCC->AHB1ENR |= (1 << 1); // GPIOB EN

    // 2. Configure PB8 (SCL) and PB9 (SDA)
    GPIOB->MODER   |= (2 << 16) | (2 << 18); // Alternate Function
    GPIOB->OTYPER  |= (1 << 8) | (1 << 9);   // Open Drain (Essential for I2C)
    GPIOB->OSPEEDR |= (3 << 16) | (3 << 18); // High Speed
    GPIOB->AFRH    |= (4 << 0) | (4 << 4);   // AF4 (I2C1)

    // 3. Reset I2C
    I2C1->CR1 |= (1 << 15);
    I2C1->CR1 &= ~(1 << 15);

    // 4. Clock Configuration (100kHz Standard Mode)
    I2C1->CR2 = 16;   // PCLK1 = 16MHz
    I2C1->CCR = 80;   // 16MHz / (2 * 100kHz) = 80
    I2C1->TRISE = 17; // Max Rise Time (1000ns / 62.5ns) + 1

    // 5. Enable I2C
    I2C1->CR1 |= 1;   // PE
}

void I2C1_Write(uint8_t addr, uint8_t reg, uint8_t data) {
    uint8_t tmp = data;
    I2C1_WriteMulti(addr, reg, &tmp, 1);
}

void I2C1_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* data, uint16_t count) {
    while(I2C1->SR2 & 2);           // Wait for Bus Busy
    I2C1->CR1 |= (1 << 8);          // Generate Start
    while(!(I2C1->SR1 & 1));        // Wait for Start Bit (SB)

    I2C1->DR = addr;                // Send Address
    while(!(I2C1->SR1 & 2));        // Wait for Address Match (ADDR)
    (void)I2C1->SR2;                // Clear ADDR flag

    while(!(I2C1->SR1 & (1 << 7))); // Wait for TXE
    I2C1->DR = reg;                 // Send Register Byte

    for(uint16_t i=0; i<count; i++) {
        while(!(I2C1->SR1 & (1 << 7)));
        I2C1->DR = data[i];
    }

    while(!(I2C1->SR1 & (1 << 7))); // Wait for TXE
    while(I2C1->SR1 & (1 << 2));    // Wait for BTF (Byte Transfer Finished)
    I2C1->CR1 |= (1 << 9);          // Generate Stop
}
