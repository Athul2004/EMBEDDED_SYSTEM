#include "stm32_f446xx.h"
#include <math.h>
#include <stdint.h>

// --- DEFINES ---
// Register to enable Floating Point Unit (FPU) to prevent crashes
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- CALIBRATION SETTINGS ---
// 1. DC OFFSET: The 'Zero Point' of your sensor (measured from previous steps)
#define DC_OFFSET 2065

// 2. CALIBRATION FACTOR: Tuned to match your Multimeter (240V / 186V * 0.50)
float calibration_factor = 0.650;

// --- FUNCTION PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read(void);
float Calculate_RMS(void);

int main(void) {
    // 1. ENABLE FPU (Must be the very first line for math to work)
    SCB_CPACR |= (0xF << 20);

    // 2. Initialize Peripherals
    UART2_Init();
    ADC1_Init();

    UART2_SendString("STM32 Energy Monitor Active.\r\n");
    UART2_SendString("Waiting for AC Mains...\r\n");

    // 3. Main Loop
    while(1) {
        // Measure Voltage
        float voltage = Calculate_RMS();

        // Print Voltage (Format: "240.50 V")
        int val_int = (int)voltage;
        int val_dec = (int)((voltage - val_int) * 100);

        UART2_SendString("Voltage: ");
        UART2_SendNumber(val_int);
        UART2_SendString(".");
        if(val_dec < 10) UART2_SendString("0"); // Leading zero for decimal
        UART2_SendNumber(val_dec);
        UART2_SendString(" V\r\n");

        // Delay ~1 second
        for(volatile uint32_t i = 0; i < 2000000; i++);
    }
}

// --- MATH & MEASUREMENT ---

float Calculate_RMS(void) {
    uint32_t num_samples = 1000;
    uint32_t buffer[1000];
    uint64_t sum_squares = 0;

    // 1. Capture Samples
    for (int i = 0; i < num_samples; i++) {
        buffer[i] = ADC1_Read();
        // Short delay to space out samples across the sine wave
        for(volatile int k=0; k<100; k++);
    }

    // 2. Calculate Squares (Remove DC Offset)
    for (int i = 0; i < num_samples; i++) {
        // Subtract the 2065 offset to center the wave at 0
        int ac_component = buffer[i] - DC_OFFSET;
        sum_squares += (ac_component * ac_component);
    }

    // 3. RMS Calculation
    float rms_raw = sqrt(sum_squares / num_samples);

    // 4. Convert to Real Voltage
    float final_voltage = rms_raw * calibration_factor;

    // --- NOISE GATE ---
    // If the voltage is tiny (phantom noise < 10V), force it to 0.
    if (final_voltage < 10.0) {
        return 0.0;
    }

    return final_voltage;
}

// --- ADC DRIVER (Bare Metal) ---

void ADC1_Init(void) {
    // Enable Clocks
    ADC1_EN();
    GPIOA_CLK_EN();

    // Configure PA0 as Analog Mode (11)
    GPIOA->MODER |= (3 << 0);

    // Enable ADC (ADON)
    ADC1->CR2 |= (1 << 0);

    // Tiny delay for ADC power up
    for(volatile int i=0; i<1000; i++);
}

uint32_t ADC1_Read(void) {
    // Start Conversion
    ADC1->CR2 |= (1 << 30);

    // Wait for End of Conversion
    while (!(ADC1->SR & (1 << 1)));

    // Read Data
    return ADC1->DR;
}

// --- UART DRIVER (Bare Metal) ---

void UART2_Init(void) {
    // Enable Clocks
    GPIOA_CLK_EN();
    USART2_EN();

    // Configure PA2 (TX) / PA3 (RX) as Alternate Function (10)
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->MODER &= ~(3 << 6); GPIOA->MODER |= (2 << 6);

    // Set AF7 (USART2)
    GPIOA->AFRL &= ~(0xF << 8); GPIOA->AFRL |= (0x7 << 8);

    // Baudrate 9600 @ 16MHz
    USART2->BRR = 0x0683;

    // Enable UART, TX, RX
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;

    if (number == 0) {
        UART2_SendString("0");
        return;
    }

    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }

    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
