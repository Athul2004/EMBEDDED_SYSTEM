#include "stm32_f446xx.h"
#include "adc.h"
#include "uart.h"
#include "dma.h"
#include "tim.h"
#include <math.h>

// --- CONFIGURATION ---
#define BUF_LEN 128
uint32_t adc_buffer[BUF_LEN];

// Tuned Calibration
#define V_OFFSET 2065
#define I_OFFSET 2045
float v_cal = 0.727;
float i_cal = 0.021;

// --- PROTOTYPES ---
void Hardware_Init(void);
void Process_Half_Buffer(int start_index); // Updated function
void UART2_SendString(char *string);
void UART2_SendNumber(int number);

int main(void) {
    SCB_CPACR |= (0xF << 20); // Enable FPU
    Hardware_Init();

    UART2_SendString("--- ADE9000 Synchronized Engine Started ---\r\n");

    while(1) {
        // 1. Wait for First Half (Samples 0 to 63) to be ready
        // Check Half Transfer Interrupt Flag (HTIF0) in DMA Low Interrupt Status Register (LISR)
        if (DMA2->LISR & (1 << 4)) {
            // Clear the flag so we don't process it twice
            DMA2->LIFCR |= (1 << 4);

            // Process the first half of the buffer safely
            Process_Half_Buffer(0);
        }

        // 2. Wait for Second Half (Samples 64 to 127) to be ready
        // Check Transfer Complete Interrupt Flag (TCIF0) in LISR
        if (DMA2->LISR & (1 << 5)) {
            // Clear the flag
            DMA2->LIFCR |= (1 << 5);

            // Process the second half safely
            Process_Half_Buffer(BUF_LEN / 2);
        }
    }
}

// --- SYNCHRONIZED PROCESSING ---
// This function processes 64 samples at a time
void Process_Half_Buffer(int start_index) {
    float sum_v_sq = 0, sum_i_sq = 0, sum_p_inst = 0;
    int limit = start_index + (BUF_LEN / 2);
    int count = 0;

    for(int n = start_index; n < limit; n += 2) {
        float v = (float)adc_buffer[n] - V_OFFSET;
        float i = (float)adc_buffer[n+1] - I_OFFSET;

        sum_v_sq += v * v;
        sum_i_sq += i * i;
        sum_p_inst += -(v * i); // Phase correction
        count++;
    }

    // --- RMS & POWER MATH ---
    float v_rms_raw = sqrtf(sum_v_sq / count);
    float i_rms_raw = sqrtf(sum_i_sq / count);

    // Apply Noise Gates
    float v_rms = (v_rms_raw < 15.0) ? 0.0 : (v_rms_raw * v_cal);
    float i_rms = (i_rms_raw < 32.0) ? 0.0 : ((i_rms_raw - 32.0) * i_cal);

    float active_power = (sum_p_inst / count) * v_cal * i_cal;

    // Safety clamp
    if (i_rms <= 0.01) active_power = 0.0;
    if (active_power < 0) active_power = -active_power;

    float apparent_power = v_rms * i_rms;

    // Power Factor
    float pf = 0;
    if (apparent_power > 1.0) {
        pf = active_power / apparent_power;
        if (pf > 1.0) pf = 1.0;
    }

    // --- OUTPUT ---
    // Only print if there is actually power, to reduce spam
    // OR print every 10th time to slow it down.
    static int print_divider = 0;
    print_divider++;

    if (print_divider > 20) { // Print roughly every 300ms
        UART2_SendString("V: "); UART2_SendNumber((int)v_rms);
        UART2_SendString("V | I: ");
        UART2_SendNumber((int)i_rms); UART2_SendString(".");
        UART2_SendNumber((int)((i_rms - (int)i_rms) * 100));
        UART2_SendString("A | P: "); UART2_SendNumber((int)active_power);
        UART2_SendString("W | PF: ");
        UART2_SendNumber((int)(pf * 100));
        UART2_SendString("%\r\n");

        print_divider = 0;
    }
}

// --- HARDWARE INIT (Same as before) ---
void Hardware_Init(void) {
    GPIOA_CLK_EN(); ADC1_EN(); USART2_EN(); DMA2_CLK_EN(); TIM2_EN();

    GPIOA->MODER |= (3 << 0) | (3 << 2);
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->AFRL  |= (7 << 8);

    USART2->BRR = 0x0683;
    USART2->CR1 = (1 << 13) | (1 << 3);

    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream0->NDTR = BUF_LEN;
    DMA2_Stream0->CR = (0 << 25) | (2 << 16) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1;

    ADC1->CR1 |= (1 << 8);
    ADC1->CR2 |= (1 << 8) | (1 << 9);
    ADC1->CR2 |= (6 << 24) | (1 << 28);
    ADC1->SQR1 = (1 << 20);
    ADC1->SQR3 = (0 << 0) | (1 << 5);
    ADC1->CR2 |= 1;

    TIM2->PSC = 0;
    TIM2->ARR = 1999;
    TIM2->CR2 |= (2 << 4);
    TIM2->CR1 |= 1;
}

// --- UART DRIVERS (Include previous UART functions here) ---
void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    if (number < 0) { UART2_SendString("-"); number = -number; }
    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
