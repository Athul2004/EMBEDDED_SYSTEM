#include "uart.h"

void UART2_Init(void) {
    // 1. Enable Clocks
    UART2_EN();
    RCC->AHB1ENR |= (1 << 0); // GPIOA EN

    // 2. Configure PA2 (TX) and PA3 (RX) for Alternate Function
    GPIOA->MODER |= (2 << 4) | (2 << 6);  // Set AF mode
    GPIOA->AFRL  |= (7 << 8) | (7 << 12); // AF7 (USART2)

    // 3. Configure Baud Rate (115200 @ 16MHz)
    // USARTDIV = 16MHz / (16 * 115200) = 8.68
    // Mantissa = 8, Fraction = 0.68 * 16 = 11 (0xB)
    USART2->BRR = 0x008B;

    // 4. Enable TX, RX, and UART
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7))); // Wait for TXE
        USART2->DR = *string++;
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    if (number < 0) { UART2_SendString("-"); number = -number; }

    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
