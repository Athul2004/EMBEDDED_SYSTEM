#include "uart.h"

void UART2_Init(void) {
    UART2_EN();
    GPIOA_EN();

    // PA2(TX), PA3(RX) -> AF7
    GPIOA->MODER  |= (2 << 4) | (2 << 6);
    GPIOA->AFRL   |= (7 << 8) | (7 << 12);

    // 115200 Baud @ 16MHz
    USART2->BRR = 0x008B;
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = *string++;
    }
}

void UART2_SendNumber(int number) {
    char buf[12]; int i=0;
    if (number == 0) { UART2_SendString("0"); return; }
    if (number < 0) { UART2_SendString("-"); number = -number; }

    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
