#include "stm32_f446xx.h"
#include <math.h>
#include <stdint.h>

// --- DEFINES ---
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- CALIBRATION ---
#define I_OFFSET 2045           // Your 3.3V Zero Point
// 1. Set this slightly ABOVE your highest RawRMS noise (28)
float i_noise_threshold = 32.0;

// 2. Adjust calibration (Since laptop 0.6A / (35rms - 32threshold) = ~0.2)
float i_calibration = 0.200; // Set very low for debugging

// --- PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read_PA1(void);
float Get_Current_Debug(void);

int main(void) {
    SCB_CPACR |= (0xF << 20); // Enable FPU
    UART2_Init();
    ADC1_Init();

    UART2_SendString("ACS712 RAW DEBUG MODE\r\n");

    while(1) {
        float amps = Get_Current_Debug();

        // Final Amp Print
        int i_int = (int)amps;
        int i_dec = (int)((amps - i_int) * 100);
        UART2_SendString(" -> Amps: ");
        UART2_SendNumber(i_int);
        UART2_SendString(".");
        if(i_dec < 10) UART2_SendString("0");
        UART2_SendNumber(i_dec);
        UART2_SendString(" A\r\n");

        for(volatile uint32_t i = 0; i < 1000000; i++);
    }
}

float Get_Current_Debug(void) {
    uint32_t samples = 2000;
    uint64_t sum_squares = 0;

    for (int i = 0; i < samples; i++) {
        uint32_t raw = ADC1_Read_PA1();
        int32_t val = (int32_t)raw - I_OFFSET;
        sum_squares += (int64_t)val * val;
        for(volatile int k=0; k<10; k++);
    }

    float rms_raw = sqrtf((float)sum_squares / (float)samples);

    // --- CRITICAL DEBUG OUTPUT ---
    // This shows the actual "strength" of the signal
    UART2_SendString("RawRMS: ");
    UART2_SendNumber((int)rms_raw);

    if (rms_raw < i_noise_threshold) return 0.0;

    return (rms_raw - i_noise_threshold) * i_calibration;
}

void ADC1_Init(void) {
    ADC1_EN();
    GPIOA_CLK_EN();
    GPIOA->MODER |= (3 << 2); // PA1 Analog
    ADC1->CR2 |= (1 << 0);    // ADON
    for(volatile int i=0; i<1000; i++);
}

uint32_t ADC1_Read_PA1(void) {
    ADC1->SQR3 = 1; // Channel 1
    ADC1->CR2 |= (1 << 30); // Start
    while (!(ADC1->SR & (1 << 1)));
    return ADC1->DR;
}

void UART2_Init(void) {
    GPIOA_CLK_EN();
    USART2_EN();
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->MODER &= ~(3 << 6); GPIOA->MODER |= (2 << 6);
    GPIOA->AFRL |= (0x7 << 8) | (0x7 << 12);
    USART2->BRR = 0x0683;
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    while (number > 0) { buf[i++] = (number % 10) + '0'; number /= 10; }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
