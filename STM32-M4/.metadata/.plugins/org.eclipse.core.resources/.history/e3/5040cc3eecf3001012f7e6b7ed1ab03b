#ifndef STM32_F446XX_H_
#define STM32_F446XX_H_

#include <stdint.h>

// Register to enable Floating Point Unit (FPU)
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- RCC (Clock Control) ---
#define RCC_BASEADDR 0X40023800U
typedef struct {
    volatile uint32_t CR, PLLCFGR, CFGR, CIR;
    volatile uint32_t AHB1RSTR, AHB2RSTR, AHB3RSTR;
    volatile uint32_t RESERVED0;
    volatile uint32_t APB1RSTR, APB2RSTR;
    volatile uint32_t RESERVED1[2];
    volatile uint32_t AHB1ENR, AHB2ENR, AHB3ENR;
    volatile uint32_t RESERVED2;
    volatile uint32_t APB1ENR, APB2ENR;
} RCC_RegDef_t;
#define RCC ((RCC_RegDef_t*)RCC_BASEADDR)

// --- GPIO (General Purpose I/O) ---
// GPIO A Base Address: 0x40020000
// GPIO B Base Address: 0x40020400 (New!)
#define GPIOA_BASEADDR 0X40020000U
#define GPIOB_BASEADDR 0X40020400U

typedef struct {
    volatile uint32_t MODER;   // Mode register
    volatile uint32_t OTYPER;  // Output type register
    volatile uint32_t OSPEEDR; // Output speed register
    volatile uint32_t PUPDR;   // Pull-up/pull-down register
    volatile uint32_t IDR;     // Input data register
    volatile uint32_t ODR;     // Output data register
    volatile uint32_t BSRR;    // Bit set/reset register
    volatile uint32_t LCKR;    // Configuration lock register
    volatile uint32_t AFRL;    // Alternate function low register
    volatile uint32_t AFRH;    // Alternate function high register
} GPIO_RegDef_t;

// Definitions for both Ports
#define GPIOA ((GPIO_RegDef_t*)GPIOA_BASEADDR)
#define GPIOB ((GPIO_RegDef_t*)GPIOB_BASEADDR)

// --- DMA (The Copier) ---
#define DMA2_BASEADDR 0x40026400U
typedef struct {
    volatile uint32_t CR, NDTR, PAR, M0AR, M1AR, FCR;
} DMA_Stream_RegDef_t;

typedef struct {
    volatile uint32_t LISR, HISR, LIFCR, HIFCR;
} DMA_RegDef_t;

#define DMA2         ((DMA_RegDef_t*)DMA2_BASEADDR)
#define DMA2_Stream0 ((DMA_Stream_RegDef_t*)(DMA2_BASEADDR + 0x10))

// --- CLOCK MACROS ---
#define GPIOA_CLK_EN() (RCC->AHB1ENR |= (1<<0))
#define GPIOB_CLK_EN() (RCC->AHB1ENR |= (1<<1)) // Enable Port B Clock
#define ADC1_EN()      (RCC->APB2ENR |= (1<<8))
#define DMA2_CLK_EN()  (RCC->AHB1ENR |= (1<<22))
#define USART2_EN()    (RCC->APB1ENR |= (1<<17))
#define TIM2_EN()      (RCC->APB1ENR |= (1<<0))
#define I2C1_EN()      (RCC->APB1ENR |= (1<<21))

#endif
