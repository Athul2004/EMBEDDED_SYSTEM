#include "stm32_f446xx.h"
#include "adc.h"
#include "uart.h"
#include "dma.h"
#include "tim.h"
#include "i2c.h"
#include <math.h>
#include <stdlib.h>
#include <string.h> // For memset

// --- CONFIGURATION ---
#define BUF_LEN 128
uint32_t adc_buffer[BUF_LEN];

// Tuned Calibration
#define V_OFFSET 2065
#define I_OFFSET 2045
float v_cal = 0.727;
float i_cal = 0.0136;

// --- OLED CONFIG ---
#define SSD1306_ADDR 0x78 // 0x3C << 1
uint8_t SSD1306_Buffer[1024]; // 128 * 64 / 8

// --- PROTOTYPES ---
void Hardware_Init(void);
void Accumulate_Energy_Data(int start_index);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);

// OLED Functions
void I2C1_Init(void);
void I2C1_Write(uint8_t addr, uint8_t reg, uint8_t data);
void I2C1_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* data, uint16_t count);
void SSD1306_Init(void);
void SSD1306_UpdateScreen(void);
void SSD1306_Clear(void);
void SSD1306_DrawChar(char ch);
void SSD1306_SetCursor(uint8_t x, uint8_t y);
void SSD1306_Print(char* str);
void SSD1306_PrintNumber(int num);

// Global Cursor
uint8_t cursor_x = 0;
uint8_t cursor_y = 0;

// --- MAIN ---
int main(void) {
    SCB_CPACR |= (0xF << 20); // Enable FPU
    Hardware_Init();

    // Initialize Screen
    SSD1306_Init();
    SSD1306_Clear();
    SSD1306_SetCursor(10, 2);
    SSD1306_Print("ENERGY METER");
    SSD1306_SetCursor(10, 4);
    SSD1306_Print("Initializing...");
    SSD1306_UpdateScreen();

    UART2_SendString("--- Energy Meter with OLED Started ---\r\n");

    while(1) {
        if (DMA2->LISR & (1 << 4)) {
            DMA2->LIFCR |= (1 << 4);
            Accumulate_Energy_Data(0);
        }
        if (DMA2->LISR & (1 << 5)) {
            DMA2->LIFCR |= (1 << 5);
            Accumulate_Energy_Data(BUF_LEN / 2);
        }
    }
}

// --- ACCUMULATION & DISPLAY ENGINE ---
void Accumulate_Energy_Data(int start_index) {
    static uint64_t acc_v_sq = 0;
    static uint64_t acc_i_sq = 0;
    static float acc_p_inst = 0;
    static int sample_count = 0;
    static int zero_cross_count = 0;
    static int last_v_sign = 0;

    int limit = start_index + (BUF_LEN / 2);

    for(int n = start_index; n < limit; n += 2) {
        int32_t v = (int32_t)adc_buffer[n] - V_OFFSET;
        int32_t i = (int32_t)adc_buffer[n+1] - I_OFFSET;

        acc_v_sq += (v * v);
        acc_i_sq += (i * i);
        acc_p_inst += (float)(-(v * i));

        // Freq Counter
        int current_v_sign = (v > 0) ? 1 : -1;
        if (current_v_sign != last_v_sign && last_v_sign != 0) zero_cross_count++;
        last_v_sign = current_v_sign;

        sample_count++;
    }

    if (sample_count >= 8000) {
        // Calculations
        float v_rms = sqrtf((float)acc_v_sq / sample_count) * v_cal;
        float i_rms = sqrtf((float)acc_i_sq / sample_count) * i_cal;
        if (v_rms < 15.0) v_rms = 0;
        if (i_rms < 0.05) i_rms = 0;

        float active_power = (acc_p_inst / sample_count) * v_cal * i_cal;
        if (i_rms == 0) active_power = 0;
        if (active_power < 0) active_power = -active_power;

        float apparent_power = v_rms * i_rms;
        float pf = (apparent_power > 0.5) ? ((active_power / apparent_power) * 100) : 0;
        if (pf > 100) pf = 100;

        float freq = (float)zero_cross_count / 2.0f;

        // --- OLED UPDATE ---
        SSD1306_Clear();

        // Voltage
        SSD1306_SetCursor(0, 0);
        SSD1306_Print("VOLT: "); SSD1306_PrintNumber((int)v_rms); SSD1306_Print(" V");

        // Current
        SSD1306_SetCursor(0, 2);
        SSD1306_Print("CURR: "); SSD1306_PrintNumber((int)i_rms); SSD1306_Print(".");
        SSD1306_PrintNumber((int)((i_rms - (int)i_rms) * 100)); SSD1306_Print(" A");

        // Power
        SSD1306_SetCursor(0, 4);
        SSD1306_Print("POWR: "); SSD1306_PrintNumber((int)active_power); SSD1306_Print(" W");

        // PF & Freq
        SSD1306_SetCursor(0, 6);
        SSD1306_Print("PF:"); SSD1306_PrintNumber((int)pf);
        SSD1306_Print("% F:"); SSD1306_PrintNumber((int)freq);

        SSD1306_UpdateScreen();

        // UART Debug
        UART2_SendString("Display Updated.\r\n");

        acc_v_sq = 0; acc_i_sq = 0; acc_p_inst = 0; sample_count = 0; zero_cross_count = 0;
    }
}

// --- HARDWARE INIT ---
void Hardware_Init(void) {
    GPIOA_CLK_EN(); ADC1_EN(); USART2_EN(); DMA2_CLK_EN(); TIM2_EN();
    I2C1_EN(); GPIOB_EN(); // Enable I2C clocks

    // GPIO A (ADC & UART)
    GPIOA->MODER |= (3 << 0) | (3 << 2);
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->AFRL  |= (7 << 8);

    // GPIO B (I2C: PB8=SCL, PB9=SDA) - Alternate Function 4
    GPIOB->MODER &= ~((3 << 16) | (3 << 18)); // Clear
    GPIOB->MODER |= (2 << 16) | (2 << 18);    // AF Mode
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);     // Open Drain (Important for I2C!)
    GPIOB->AFRH &= ~((0xF << 0) | (0xF << 4));
    GPIOB->AFRH |= (4 << 0) | (4 << 4);       // AF4 = I2C1

    // Peripherals Setup
    USART2->BRR = 0x008B; USART2->CR1 = (1 << 13) | (1 << 3);
    I2C1_Init(); // Start I2C

    // DMA & ADC
    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream0->NDTR = BUF_LEN;
    DMA2_Stream0->CR = (0 << 25) | (2 << 16) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1;

    ADC1->CR1 |= (1 << 8);
    ADC1->CR2 |= (1 << 8) | (1 << 9) | (6 << 24) | (1 << 28) | 1;
    ADC1->SQR1 = (1 << 20); ADC1->SQR3 = (0 << 0) | (1 << 5);

    TIM2->PSC = 0; TIM2->ARR = 1999; TIM2->CR2 |= (2 << 4); TIM2->CR1 |= 1;
}

// --- I2C DRIVERS ---
void I2C1_Init(void) {
    I2C1->CR1 |= (1 << 15); // Reset
    I2C1->CR1 &= ~(1 << 15);
    I2C1->CR2 = 16;         // 16MHz PCLK
    I2C1->CCR = 80;         // 100kHz Standard Mode
    I2C1->TRISE = 17;       // Max rise time
    I2C1->CR1 |= 1;         // Enable PE
}

void I2C1_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* data, uint16_t count) {
    while(I2C1->SR2 & 2);          // Wait if busy
    I2C1->CR1 |= (1 << 8);         // Start
    while(!(I2C1->SR1 & 1));       // Wait SB
    I2C1->DR = addr;               // Send Address
    while(!(I2C1->SR1 & 2));       // Wait ADDR
    (void)I2C1->SR2;               // Clear ADDR

    // Send Control Byte (0x40 for data, 0x00 for command)
    while(!(I2C1->SR1 & (1 << 7)));
    I2C1->DR = reg;

    for(uint16_t i=0; i<count; i++) {
        while(!(I2C1->SR1 & (1 << 7)));
        I2C1->DR = data[i];
    }

    while(!(I2C1->SR1 & (1 << 7))); // Wait TXE
    while(I2C1->SR1 & (1 << 2));    // Wait BTF
    I2C1->CR1 |= (1 << 9);          // Stop
}

void I2C1_Write(uint8_t addr, uint8_t reg, uint8_t data) {
    uint8_t tmp = data;
    I2C1_WriteMulti(addr, reg, &tmp, 1);
}

// --- SSD1306 Oled Drivers ---
// Simple 5x7 Font (Numbers + Space + V + A + W + P + F + : + . + %)
const uint8_t Font5x7[][5] = {
    {0x3E, 0x51, 0x49, 0x45, 0x3E}, // 0
    {0x00, 0x42, 0x7F, 0x40, 0x00}, // 1
    {0x42, 0x61, 0x51, 0x49, 0x46}, // 2
    {0x21, 0x41, 0x45, 0x4B, 0x31}, // 3
    {0x18, 0x14, 0x12, 0x7F, 0x10}, // 4
    {0x27, 0x45, 0x45, 0x45, 0x39}, // 5
    {0x3C, 0x4A, 0x49, 0x49, 0x30}, // 6
    {0x01, 0x71, 0x09, 0x05, 0x03}, // 7
    {0x36, 0x49, 0x49, 0x49, 0x36}, // 8
    {0x06, 0x49, 0x49, 0x29, 0x1E}, // 9
    {0x00, 0x00, 0x00, 0x00, 0x00}, // Space (10)
    {0x1F, 0x20, 0x40, 0x20, 0x1F}, // V (11)
    {0x7E, 0x09, 0x09, 0x09, 0x7E}, // A (12)
    {0x3F, 0x40, 0x38, 0x40, 0x3F}, // W (13)
    {0x7F, 0x09, 0x09, 0x09, 0x06}, // P (14)
    {0x7F, 0x09, 0x09, 0x09, 0x01}, // F (15)
    {0x36, 0x36, 0x00, 0x00, 0x00}, // : (16)
    {0x00, 0x60, 0x60, 0x00, 0x00}, // . (17)
    {0x22, 0x14, 0x08, 0x14, 0x22}, // % (18)
    {0x7F, 0x49, 0x49, 0x49, 0x41}, // E (19)
    {0x7F, 0x40, 0x40, 0x40, 0x40}, // L (20)
    {0x3E, 0x41, 0x41, 0x41, 0x3E}, // O (21)
    {0x01, 0x01, 0x7F, 0x01, 0x01}, // T (22)
    {0x3E, 0x41, 0x41, 0x41, 0x22}, // C (23)
    {0x7F, 0x08, 0x08, 0x08, 0x7F}, // H (24)
    {0x3F, 0x40, 0x40, 0x40, 0x3F}, // U (25)
    {0x7F, 0x09, 0x19, 0x29, 0x46}  // R (26)
};

void SSD1306_Init(void) {
    // Init Sequence for 128x64 OLED
    uint8_t cmds[] = {
        0xAE, 0x20, 0x10, 0xB0, 0xC8, 0x00, 0x10, 0x40,
        0x81, 0xFF, 0xA1, 0xA6, 0xA8, 0x3F, 0xA4, 0xD3,
        0x00, 0xD5, 0xF0, 0xD9, 0x22, 0xDA, 0x12, 0xDB,
        0x20, 0x8D, 0x14, 0xAF
    };
    for(int i=0; i<sizeof(cmds); i++) I2C1_Write(SSD1306_ADDR, 0x00, cmds[i]);
}

void SSD1306_Clear(void) {
    memset(SSD1306_Buffer, 0, sizeof(SSD1306_Buffer));
}

void SSD1306_UpdateScreen(void) {
    for(uint8_t i=0; i<8; i++) {
        I2C1_Write(SSD1306_ADDR, 0x00, 0xB0 + i); // Set Page
        I2C1_Write(SSD1306_ADDR, 0x00, 0x00);     // Low Col
        I2C1_Write(SSD1306_ADDR, 0x00, 0x10);     // High Col
        I2C1_WriteMulti(SSD1306_ADDR, 0x40, &SSD1306_Buffer[128*i], 128);
    }
}

void SSD1306_DrawChar(char ch) {
    int idx = 10; // Default Space
    if (ch >= '0' && ch <= '9') idx = ch - '0';
    else if (ch == ' ') idx = 10;
    else if (ch == 'V') idx = 11;
    else if (ch == 'A') idx = 12;
    else if (ch == 'W') idx = 13;
    else if (ch == 'P') idx = 14;
    else if (ch == 'F') idx = 15;
    else if (ch == ':') idx = 16;
    else if (ch == '.') idx = 17;
    else if (ch == '%') idx = 18;
    else if (ch == 'E') idx = 19;
    else if (ch == 'L') idx = 20;
    else if (ch == 'O') idx = 21;
    else if (ch == 'T') idx = 22;
    else if (ch == 'C') idx = 23;
    else if (ch == 'H') idx = 24;
    else if (ch == 'U') idx = 25;
    else if (ch == 'R') idx = 26;

    if (cursor_x > 120) return;

    for (int i = 0; i < 5; i++) {
        SSD1306_Buffer[cursor_x + (cursor_y * 128)] = Font5x7[idx][i];
        cursor_x++;
    }
    cursor_x++; // Gap
}

void SSD1306_Print(char* str) {
    while (*str) {
        SSD1306_DrawChar(*str++);
    }
}

void SSD1306_PrintNumber(int num) {
    char buf[10];
    itoa(num, buf, 10);
    SSD1306_Print(buf);
}

void SSD1306_SetCursor(uint8_t x, uint8_t y) {
    cursor_x = x;
    cursor_y = y;
}

// --- UART (Keep for debug) ---
void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}
void UART2_SendNumber(int number) {
    char buf[12]; itoa(number, buf, 10); UART2_SendString(buf);
}
