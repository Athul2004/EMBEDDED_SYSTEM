#include <stdint.h>
#include "stm32_f446xx.h"

void uart2_init(void)
{
    /* Enable clocks */
    RCC->AHB1ENR |= (1 << 0);      // GPIOA clock
    RCC->APB1ENR |= (1 << 17);     // USART2 clock

    /* PA2, PA3 -> Alternate function */
    GPIOA->MODER &= ~((3 << (2*2)) | (3 << (3*2)));
    GPIOA->MODER |=  ((2 << (2*2)) | (2 << (3*2)));

    /* AF7 for USART2 (PA2, PA3) */
    GPIOA->AFRL |= (7 << (2 * 4)) | (7 << (3 * 4));

    /* Baud rate: 115200 @ 16 MHz */
    USART2->BRR = 0x8B;

    /* Enable TX and USART */
    USART2->CR1 |= (1 << 3);   // TE
    USART2->CR1 |= (1 << 13);  // UE
}

void uart2_send(char c)
{
    while (!(USART2->SR & (1 << 7)));
    USART2->DR = c;
}

void uart2_print(char *s)
{
    while (*s)
        uart2_send(*s++);
}

int main(void)
{
    uart2_init();

    while (1)
    {
        uart2_print("Hello World\r\n");
        for (volatile int i = 0; i < 1000000; i++);
    }
}


