#include "stm32_f446xx.h"
#include <math.h>
#include <stdint.h>

// --- REGISTER DEFINES ---
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- CALIBRATION: VOLTAGE (PA0) ---
#define V_OFFSET 2065           // Your ZMPT101B center
float v_calibration = 0.727;    // Your tuned factor

// --- CALIBRATION: CURRENT (PA1) ---
#define I_OFFSET 2045           // Your 3.3V ACS712 center
float i_noise_threshold = 32.0; // Wall to block static noise (27 units)
float i_calibration = 0.021;    // Tuned for ~0.6A laptop load

// --- PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read_Channel(uint8_t channel);
float Get_Voltage_RMS(void);
float Get_Current_RMS(void);

int main(void) {
    // 1. Enable FPU for floating point math
    SCB_CPACR |= (0xF << 20);

    // 2. Initialize Hardware
    UART2_Init();
    ADC1_Init();

    UART2_SendString("--- STM32 AC ENERGY MONITOR ACTIVE ---\r\n");

    while(1) {
        // 3. Perform Measurements
        float volts = Get_Voltage_RMS();
        float amps  = Get_Current_RMS();
        float watts = volts * amps;

        // 4. Print Results to UART
        UART2_SendString("V: ");
        UART2_SendNumber((int)volts);
        UART2_SendString("V | ");

        // Manual float printing for Amps (e.g. 0.65 A)
        int i_int = (int)amps;
        int i_dec = (int)((amps - i_int) * 100);
        UART2_SendString("I: ");
        UART2_SendNumber(i_int);
        UART2_SendString(".");
        if(i_dec < 10) UART2_SendString("0");
        UART2_SendNumber(i_dec);
        UART2_SendString("A | ");

        UART2_SendString("P: ");
        UART2_SendNumber((int)watts);
        UART2_SendString("W\r\n");

        // Delay ~1 second for readability
        for(volatile uint32_t i = 0; i < 2000000; i++);
    }
}

// --- VOLTAGE SENSING LOGIC (PA0) ---

float Get_Voltage_RMS(void) {
    uint32_t samples = 1000;
    uint64_t sum_squares = 0;

    for (int i = 0; i < samples; i++) {
        int raw = ADC1_Read_Channel(0); // Channel 0 (PA0)
        int val = raw - V_OFFSET;
        sum_squares += (int64_t)val * val;
        for(volatile int k=0; k<40; k++);
    }

    float rms = sqrtf((float)sum_squares / (float)samples);
    float volts = rms * v_calibration;

    // Voltage Noise Gate (Ignore ghost voltage < 10V)
    if (volts < 10.0) return 0.0;
    return volts;
}

// --- CURRENT SENSING LOGIC (PA1) ---

float Get_Current_RMS(void) {
    uint32_t samples = 4000; // High sampling count to stabilize ACS712 noise
    uint64_t sum_squares = 0;

    for (int i = 0; i < samples; i++) {
        int raw = ADC1_Read_Channel(1); // Channel 1 (PA1)
        int val = raw - I_OFFSET;
        sum_squares += (int64_t)val * val;
        for(volatile int k=0; k<5; k++); // Fast sampling for spikes
    }

    float rms_raw = sqrtf((float)sum_squares / (float)samples);

    // Filter out static noise (If jitter is below 32, it's not real current)
    if (rms_raw < i_noise_threshold) {
        return 0.0;
    }

    // Scale signal above threshold to real Amps
    float amps = (rms_raw - i_noise_threshold) * i_calibration;
    return amps;
}

// --- BARE METAL DRIVERS ---

void ADC1_Init(void) {
    ADC1_EN();
    GPIOA_CLK_EN();
    // Set PA0 and PA1 to Analog Mode
    GPIOA->MODER |= (3 << 0) | (3 << 2);
    ADC1->CR2 |= (1 << 0); // ADON
    for(volatile int i=0; i<1000; i++);
}

uint32_t ADC1_Read_Channel(uint8_t channel) {
    ADC1->SQR3 = channel;
    ADC1->CR2 |= (1 << 30);
    while (!(ADC1->SR & (1 << 1)));
    return ADC1->DR;
}

void UART2_Init(void) {
    GPIOA_CLK_EN();
    USART2_EN();
    // PA2 (TX) and PA3 (RX)
    GPIOA->MODER &= ~((3 << 4) | (3 << 6));
    GPIOA->MODER |=  ((2 << 4) | (2 << 6));
    GPIOA->AFRL  |=  ((7 << 8) | (7 << 12));
    USART2->BRR = 0x0683; // 9600 Baud
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    if (number < 0) { UART2_SendString("-"); number = -number; }
    while (number > 0) { buf[i++] = (number % 10) + '0'; number /= 10; }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
