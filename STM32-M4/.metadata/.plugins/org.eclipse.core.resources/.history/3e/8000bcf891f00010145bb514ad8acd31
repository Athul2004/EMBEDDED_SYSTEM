#include "stm32_f446xx.h"
#include <stdio.h>

/* ================= UART2 ================= */

void uart2_init(void)
{
    /* Enable clocks */
    RCC->AHB1ENR |= (1 << 0);    // GPIOA
    RCC->APB1ENR |= (1 << 17);   // USART2

    /* PA2, PA3 -> AF mode */
    GPIOA->MODER &= ~(0xF << (2 * 2));
    GPIOA->MODER |=  (0xA << (2 * 2));

    /* AF7 for USART2 */
    GPIOA->AFRL &= ~(0xFF << (4 * 2));
    GPIOA->AFRL |=  (0x77 << (4 * 2));

    /* Baud rate = 115200 @16MHz */
    USART2->BRR = 0x8B;

    /* Enable TX + RX */
    USART2->CR1 |= (1 << 3);
    USART2->CR1 |= (1 << 2);

    /* Enable USART */
    USART2->CR1 |= (1 << 13);
}

/* printf redirection */
int __io_putchar(int ch)
{
    while (!(USART2->SR & (1 << 7)));
    USART2->DR = ch;
    return ch;
}

/* ================= ADC1 ================= */

void adc1_init(void)
{
    /* GPIOA + ADC1 clock */
    RCC->AHB1ENR |= (1 << 0);
    RCC->APB2ENR |= (1 << 8);

    /* PA0 analog mode */
    GPIOA->MODER |= (3 << 0);

    /* ADC configuration */
    ADC1->CR2 = 0;
    ADC1->SQR3 = 0;      // Channel 0
    ADC1->SMPR2 |= (7 << 0); // Max sample time

    /* Enable ADC */
    ADC1->CR2 |= (1 << 0);
}

uint16_t adc1_read(void)
{
    ADC1->CR2 |= (1 << 30);           // Start conversion
    while (!(ADC1->SR & (1 << 1)));   // EOC
    return ADC1->DR;
}

/* ================= MAIN ================= */

int main(void)
{
    uart2_init();
    adc1_init();

    printf("\r\nSTM32 UART + ADC READY\r\n");

    while (1)
    {
        uint16_t adc = adc1_read();
        printf("ZMPT ADC = %u\r\n", adc);

        for (volatile int i = 0; i < 1000000; i++);
    }
}

