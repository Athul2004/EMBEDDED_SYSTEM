#include "dma.h"
#include "adc.h" // Needed to see ADC1->DR

void DMA2_Init(uint32_t* buffer, uint16_t size) {
    DMA2_EN();

    DMA2_Stream0->CR &= ~1; // Disable Stream
    while(DMA2_Stream0->CR & 1);

    // Connect ADC DR to Memory Buffer
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)buffer;
    DMA2_Stream0->NDTR = size;

    // CH0, MSIZE=32, PSIZE=32, MINC, CIRC, DIR=P2M, TCIE, HTIE
    DMA2_Stream0->CR = (0 << 25) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1; // Enable
}
