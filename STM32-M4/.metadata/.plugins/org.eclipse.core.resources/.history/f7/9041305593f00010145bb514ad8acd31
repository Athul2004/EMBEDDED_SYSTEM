#include "stm32_f446xx.h"
#include <stdint.h>

void UART2_Init(void);
void UART2_Write(int ch);
void print_hello(char *msg);

int main(void) {
    // 1. Initialize UART2
    UART2_Init();

    while(1) {
        print_hello("Hello World from STM32F446!\r\n");

        // Simple delay loop
        for(uint32_t i = 0; i < 500000; i++);
    }
}

void UART2_Init(void) {
    // 1. Enable Clock for UART2 and GPIOA
    UART2_EN();
    GPIOA_CLK_EN();

    // 2. Configure PA2 as UART2_TX (Alternate Function mode)
    // Clear bits 4-5, then set to '10' for Alt Function
    GPIOA->MODER &= ~(3 << 4);
    GPIOA->MODER |=  (2 << 4);

    // 3. Set Alternate Function Type to AF7 (USART2) in AFRL
    // PA2 is pin 2, so we modify AFRL bits 8-11
    GPIOA->AFRL &= ~(0xF << 8);
    GPIOA->AFRL |=  (0x7 << 8);

    // 4. Configure Baudrate (Default 16MHz Clock, 9600 Baud)
    // Formula: SystemClock / (16 * Baudrate) = 16MHz / (16 * 9600) = 104.18
    // Fraction: 0.18 * 16 = ~3. BRR = 0x683
    USART2->BRR = 0x0683;

    // 5. Enable Transmitter and UART
    USART2->CR1 |= (1 << 3);  // TE: Transmitter Enable
    USART2->CR1 |= (1 << 13); // UE: USART Enable
}

void UART2_Write(int ch) {
    // Wait until Transmit Data Register is empty (Status Register bit 7)
    while (!(USART2->SR & (1 << 7)));
    USART2->DR = (ch & 0xFF);
}

void print_hello(char *msg) {
    while(*msg) {
        UART2_Write(*msg++);
    }
}
