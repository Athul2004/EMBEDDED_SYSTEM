#include "stm32_f446xx.h"
#include "adc.h"
#include "uart.h"
#include "dma.h"
#include "tim.h"
#include <math.h>
#include <stdlib.h> // Required for abs()

// --- CONFIGURATION ---
#define BUF_LEN 128
uint32_t adc_buffer[BUF_LEN];

// Tuned Calibration
#define V_OFFSET 2065
#define I_OFFSET 2045
float v_cal = 0.727;
float i_cal = 0.0136; // Tuned for your 150W load

// --- PROTOTYPES ---
void Hardware_Init(void);
void Accumulate_Energy_Data(int start_index);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);

// --- MAIN ---
int main(void) {
    SCB_CPACR |= (0xF << 20); // Enable FPU
    Hardware_Init();

    // IMPORTANT: Set Serial Terminal to 115200 Baud
    UART2_SendString("--- STM32 DSP Engine: Advanced Metering (List 1 & 2) ---\r\n");

    while(1) {
        // 1. Process First Half of Buffer (Samples 0-63)
        if (DMA2->LISR & (1 << 4)) {      // Check Half-Transfer Flag
            DMA2->LIFCR |= (1 << 4);      // Clear Flag
            Accumulate_Energy_Data(0);
        }

        // 2. Process Second Half of Buffer (Samples 64-127)
        if (DMA2->LISR & (1 << 5)) {      // Check Transfer-Complete Flag
            DMA2->LIFCR |= (1 << 5);      // Clear Flag
            Accumulate_Energy_Data(BUF_LEN / 2);
        }
    }
}

// --- ADVANCED DSP ACCUMULATION ENGINE ---
void Accumulate_Energy_Data(int start_index) {
    // Static variables preserve data across multiple function calls
    static uint64_t acc_v_sq = 0;
    static uint64_t acc_i_sq = 0;
    static float acc_p_inst = 0;
    static int sample_count = 0;

    // Advanced features: Peak & Frequency
    static int v_peak_max = 0;
    static int i_peak_max = 0;
    static int last_v_sign = 0;
    static int zero_cross_count = 0;

    int limit = start_index + (BUF_LEN / 2);

    // --- HIGH SPEED LOOP (Runs 8000 times/sec) ---
    for(int n = start_index; n < limit; n += 2) {
        int32_t v = (int32_t)adc_buffer[n] - V_OFFSET;
        int32_t i = (int32_t)adc_buffer[n+1] - I_OFFSET;

        // 1. Basic Accumulation (RMS & Power)
        acc_v_sq += (v * v);
        acc_i_sq += (i * i);
        acc_p_inst += (float)(-(v * i)); // Phase correction

        // 2. Peak Detection (Find absolute max value)
        if (abs(v) > v_peak_max) v_peak_max = abs(v);
        if (abs(i) > i_peak_max) i_peak_max = abs(i);

        // 3. Frequency Counter (Detect Zero Crossings)
        // Check if voltage sign flips from + to - or - to +
        int current_v_sign = (v > 0) ? 1 : -1;
        if (current_v_sign != last_v_sign && last_v_sign != 0) {
            zero_cross_count++;
        }
        last_v_sign = current_v_sign;

        sample_count++;
    }

    // --- CALCULATION & PRINT LOOP (Runs once every ~1 second) ---
    if (sample_count >= 8000) {

        // A. Calculate RMS
        float v_rms_raw = sqrtf((float)acc_v_sq / sample_count);
        float i_rms_raw = sqrtf((float)acc_i_sq / sample_count);

        // Noise Gates
        float v_rms = (v_rms_raw < 15.0) ? 0.0 : (v_rms_raw * v_cal);
        float i_rms = (i_rms_raw < 32.0) ? 0.0 : (i_rms_raw * i_cal);

        // B. Calculate Active Power (Watts)
        float active_power = (acc_p_inst / sample_count) * v_cal * i_cal;
        if (i_rms <= 0.01f) active_power = 0.0f;
        if (active_power < 0) active_power = -active_power;

        // C. Calculate Apparent Power (VA)
        float apparent_power = v_rms * i_rms;

        // D. Calculate Reactive Power (VAR) - List 2 Feature
        // Formula: Q = sqrt(S^2 - P^2)
        float reactive_power = 0;
        if (apparent_power > active_power) {
            reactive_power = sqrtf((apparent_power * apparent_power) - (active_power * active_power));
        }

        // E. Calculate Power Factor
        float pf = 0;
        if (apparent_power > 0.5f) {
            pf = (active_power / apparent_power) * 100.0f;
            if (pf > 100.0f) pf = 100.0f;
        }

        // F. Calculate Frequency - List 2 Feature
        // One cycle has 2 crossings. Freq = Crossings / 2.
        float frequency = (float)zero_cross_count / 2.0f;

        // G. Calculate Peaks - List 2 Feature
        float v_peak = (float)v_peak_max * v_cal;
        float i_peak = (float)i_peak_max * i_cal;

        // --- UART OUTPUT ---
        UART2_SendString("--------------------------------\r\n");
        // Row 1: Basic
        UART2_SendString("V: "); UART2_SendNumber((int)v_rms);
        UART2_SendString("V | I: ");
        UART2_SendNumber((int)i_rms); UART2_SendString(".");
        UART2_SendNumber((int)((i_rms - (int)i_rms) * 100));
        UART2_SendString("A | P: "); UART2_SendNumber((int)active_power);
        UART2_SendString("W\r\n");

        // Row 2: Advanced (Reactive, PF, Freq)
        UART2_SendString("Q: "); UART2_SendNumber((int)reactive_power);
        UART2_SendString("VAR | PF: "); UART2_SendNumber((int)pf);
        UART2_SendString("% | Freq: "); UART2_SendNumber((int)frequency);
        UART2_SendString("Hz\r\n");

        // Row 3: Peaks
        UART2_SendString("Pk-V: "); UART2_SendNumber((int)v_peak);
        UART2_SendString("V | Pk-I: "); UART2_SendNumber((int)i_peak);
        UART2_SendString(".");
        UART2_SendNumber((int)((i_peak - (int)i_peak) * 100));
        UART2_SendString("A\r\n");

        // --- RESET ACCUMULATORS ---
        acc_v_sq = 0;
        acc_i_sq = 0;
        acc_p_inst = 0;
        sample_count = 0;
        v_peak_max = 0;
        i_peak_max = 0;
        zero_cross_count = 0;
    }
}

// --- HARDWARE INIT ---
void Hardware_Init(void) {
    GPIOA_CLK_EN(); ADC1_EN(); USART2_EN(); DMA2_CLK_EN(); TIM2_EN();

    // GPIO Setup
    GPIOA->MODER |= (3 << 0) | (3 << 2);      // PA0, PA1 Analog
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4); // PA2 AF
    GPIOA->AFRL  |= (7 << 8);                 // AF7 for UART

    // UART Setup (115200 Baud)
    USART2->BRR = 0x008B;
    USART2->CR1 = (1 << 13) | (1 << 3);

    // DMA Setup
    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream0->NDTR = BUF_LEN;
    DMA2_Stream0->CR = (0 << 25) | (2 << 16) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1;

    // ADC Setup
    ADC1->CR1 |= (1 << 8);
    ADC1->CR2 |= (1 << 8) | (1 << 9);
    ADC1->CR2 |= (6 << 24) | (1 << 28);
    ADC1->SQR1 = (1 << 20);
    ADC1->SQR3 = (0 << 0) | (1 << 5);
    ADC1->CR2 |= 1;

    // Timer Setup (8kHz)
    TIM2->PSC = 0;
    TIM2->ARR = 1999;
    TIM2->CR2 |= (2 << 4);
    TIM2->CR1 |= 1;
}

// --- UART DRIVERS ---
void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    if (number < 0) { UART2_SendString("-"); number = -number; }
    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
