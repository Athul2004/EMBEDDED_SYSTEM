#include "stm32_f446xx.h"
#include "adc.h"
#include "uart.h"
#include "dma.h"
#include "tim.h"
#include <math.h>

// --- CONFIGURATION ---
#define BUF_LEN 128
uint32_t adc_buffer[BUF_LEN];

// Tuned Calibration
#define V_OFFSET 2065
#define I_OFFSET 2045
float v_cal = 0.727;
float i_cal = 0.0136;

// --- PROTOTYPES ---
void Hardware_Init(void);
void Accumulate_Energy_Data(int start_index);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);

int main(void) {
    SCB_CPACR |= (0xF << 20); // Enable FPU
    Hardware_Init();

    // IMPORTANT: Change your PuTTY/Serial Terminal to 115200 Baud!
    UART2_SendString("--- ADE9000 Accumulation Engine (1 Second Average) ---\r\n");

    while(1) {
        // 1. Check Half Transfer (First 64 samples ready)
        if (DMA2->LISR & (1 << 4)) {
            DMA2->LIFCR |= (1 << 4);  // Clear Flag
            Accumulate_Energy_Data(0);
        }

        // 2. Check Transfer Complete (Next 64 samples ready)
        if (DMA2->LISR & (1 << 5)) {
            DMA2->LIFCR |= (1 << 5);  // Clear Flag
            Accumulate_Energy_Data(BUF_LEN / 2);
        }
    }
}

// --- ACCUMULATION ENGINE (LOGIC FIXED) ---
void Accumulate_Energy_Data(int start_index) {
    static uint64_t acc_v_sq = 0;
    static uint64_t acc_i_sq = 0;
    static float acc_p_inst = 0;
    static int sample_count = 0;

    int limit = start_index + (BUF_LEN / 2);

    for(int n = start_index; n < limit; n += 2) {
        int32_t v = (int32_t)adc_buffer[n] - V_OFFSET;
        int32_t i = (int32_t)adc_buffer[n+1] - I_OFFSET;

        acc_v_sq += (v * v);
        acc_i_sq += (i * i);
        acc_p_inst += (float)(-(v * i)); // Phase correction
        sample_count++;
    }

    // Process once per second (approx 8000 samples)
    if (sample_count >= 8000) {

        float v_rms_raw = sqrtf((float)acc_v_sq / sample_count);
        float i_rms_raw = sqrtf((float)acc_i_sq / sample_count);

        // --- FIX 1: SIMPLE GATING (No Subtraction) ---
        // If signal > threshold, show the FULL value. Don't subtract 32.
        float v_rms = (v_rms_raw < 15.0) ? 0.0 : (v_rms_raw * v_cal);
        float i_rms = (i_rms_raw < 32.0) ? 0.0 : (i_rms_raw * i_cal);

        // Active Power Calculation
        float active_power = (acc_p_inst / sample_count) * v_cal * i_cal;

        // Safety: If Current is zero, Power must be zero
        if (i_rms == 0.0f) active_power = 0.0;

        // Absolute value for power
        if (active_power < 0) active_power = -active_power;

        float apparent_power = v_rms * i_rms;

        // --- FIX 2: ACCURATE PF CALCULATION ---
        float pf = 0;
        if (apparent_power > 0.5f) { // Avoid division by zero
            pf = (active_power / apparent_power) * 100.0f;
            if (pf > 100.0f) pf = 100.0f; // Cap at 100%
        }

        // Print Results
        UART2_SendString("V: "); UART2_SendNumber((int)v_rms);
        UART2_SendString(" V | I: ");
        UART2_SendNumber((int)i_rms); UART2_SendString(".");
        UART2_SendNumber((int)((i_rms - (int)i_rms) * 100));
        UART2_SendString(" A | P: "); UART2_SendNumber((int)active_power);
        UART2_SendString(" W | PF: "); UART2_SendNumber((int)pf);
        UART2_SendString(" %\r\n");

        // Reset
        acc_v_sq = 0;
        acc_i_sq = 0;
        acc_p_inst = 0;
        sample_count = 0;
    }
}

// --- HARDWARE INIT (Updated for 115200 Baud) ---
void Hardware_Init(void) {
    GPIOA_CLK_EN(); ADC1_EN(); USART2_EN(); DMA2_CLK_EN(); TIM2_EN();

    // GPIO
    GPIOA->MODER |= (3 << 0) | (3 << 2);
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->AFRL  |= (7 << 8);

    // UART: Changed to 115200 Baud (Fast)
    // 16MHz / (16 * 115200) = 8.68 -> Mantissa 8, Fraction 11 (0xB)
    USART2->BRR = 0x008B;
    USART2->CR1 = (1 << 13) | (1 << 3);

    // DMA
    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream0->NDTR = BUF_LEN;
    DMA2_Stream0->CR = (0 << 25) | (2 << 16) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1;

    // ADC
    ADC1->CR1 |= (1 << 8);
    ADC1->CR2 |= (1 << 8) | (1 << 9);
    ADC1->CR2 |= (6 << 24) | (1 << 28);
    ADC1->SQR1 = (1 << 20);
    ADC1->SQR3 = (0 << 0) | (1 << 5);
    ADC1->CR2 |= 1;

    // Timer (8kHz)
    TIM2->PSC = 0;
    TIM2->ARR = 1999;
    TIM2->CR2 |= (2 << 4);
    TIM2->CR1 |= 1;
}

// --- UART DRIVERS ---
void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    if (number < 0) { UART2_SendString("-"); number = -number; }
    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
