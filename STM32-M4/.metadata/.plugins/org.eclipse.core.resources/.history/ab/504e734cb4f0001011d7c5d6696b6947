#include "stm32_f446xx.h"
#include <stdint.h>

// --- DEFINES ---
// Register to enable Floating Point Unit (FPU) to prevent crashes
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- FUNCTION PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read(void);

int main(void) {
    // 1. ENABLE FPU (Must be the very first line)
    // Sets bits 20-23 to '1' to enable full access to CP10 and CP11
    SCB_CPACR |= (0xF << 20);

    // 2. Initialize Peripherals
    UART2_Init();
    ADC1_Init();

    UART2_SendString("STM32 ZMPT101B Raw Debugger Started...\r\n");

    // 3. Main Debug Loop
    while(1) {
        uint32_t min_val = 4096;
        uint32_t max_val = 0;

        // Capture 1000 samples to find the signal extremes
        for(int i = 0; i < 1000; i++) {
            uint32_t val = ADC1_Read();

            if(val < min_val) min_val = val;
            if(val > max_val) max_val = val;

            // Short delay to space out samples (simulates sampling rate)
            for(volatile int k = 0; k < 100; k++);
        }

        // Calculate the Noise/Signal Range
        uint32_t range = max_val - min_val;

        // Print Stats to PuTTY
        UART2_SendString("Min: ");
        UART2_SendNumber(min_val);
        UART2_SendString("  Max: ");
        UART2_SendNumber(max_val);
        UART2_SendString("  Range: ");
        UART2_SendNumber(range);

        // Diagnosis hints
        if (range > 3000) {
            UART2_SendString("  [Check Wire! Floating]");
        } else if (range > 200) {
            UART2_SendString("  [High Noise/Gain]");
        } else {
            UART2_SendString("  [Stable]");
        }

        UART2_SendString("\r\n");

        // Delay ~1 second before next report
        for(volatile uint32_t i = 0; i < 2000000; i++);
    }
}

// --- ADC DRIVER ---

void ADC1_Init(void) {
    // 1. Enable Clocks (ADC1 and GPIOA)
    ADC1_EN();
    GPIOA_CLK_EN();

    // 2. Configure PA0 as Analog Mode (11)
    GPIOA->MODER |= (3 << 0);

    // 3. Configure ADC Control Register 2
    // Enable ADC (ADON)
    ADC1->CR2 |= (1 << 0);

    // Allow a tiny delay for ADC to power up
    for(volatile int i=0; i<1000; i++);
}

uint32_t ADC1_Read(void) {
    // 1. Start Conversion (SWSTART bit 30)
    ADC1->CR2 |= (1 << 30);

    // 2. Wait for End of Conversion (EOC bit 1 in SR)
    while (!(ADC1->SR & (1 << 1)));

    // 3. Read Data Register (12-bit result)
    return ADC1->DR;
}

// --- UART DRIVER ---

void UART2_Init(void) {
    // 1. Enable Clocks
    GPIOA_CLK_EN();
    USART2_EN();

    // 2. Configure PA2 (TX) and PA3 (RX) as Alternate Function
    // Clear bits then set to '10' (Alternate Function)
    GPIOA->MODER &= ~(3 << 4); // PA2
    GPIOA->MODER |=  (2 << 4);
    GPIOA->MODER &= ~(3 << 6); // PA3
    GPIOA->MODER |=  (2 << 6);

    // 3. Set Alternate Function Type to AF7 (USART2)
    GPIOA->AFRL &= ~(0xFF << 8);
    GPIOA->AFRL |=  (0x77 << 8);

    // 4. Configure Baudrate (9600 @ 16MHz)
    USART2->BRR = 0x0683;

    // 5. Enable UART (UE), Transmitter (TE), Receiver (RE)
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7))); // Wait for TXE (Transmit Empty)
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;

    if (number == 0) {
        UART2_SendString("0");
        return;
    }

    // Convert integer to string (reverse order)
    while (number > 0) {
        buf[i++] = (number % 10) + '0';
        number /= 10;
    }

    // Send characters in correct order
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
