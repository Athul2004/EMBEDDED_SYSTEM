#ifndef I2C_H_
#define I2C_H_

#include "stm32_f446xx.h"

#define GPIOB_BASEADDR 0x40020400U
#define I2C1_BASEADDR  0x40005400U

// GPIO Struct is usually in uart.h or common, but if isolated:
#ifndef GPIO_STRUCT_DEFINED
#define GPIO_STRUCT_DEFINED
typedef struct {
    volatile uint32_t MODER;
    volatile uint32_t OTYPER;
    volatile uint32_t OSPEEDR;
    volatile uint32_t PUPDR;
    volatile uint32_t IDR;
    volatile uint32_t ODR;
    volatile uint32_t BSRR;
    volatile uint32_t LCKR;
    volatile uint32_t AFRL;
    volatile uint32_t AFRH;
} GPIO_RegDef_t_I2C; // Renamed to avoid conflict if both headers included
#endif

// I2C Struct
typedef struct {
    volatile uint32_t CR1;
    volatile uint32_t CR2;
    volatile uint32_t OAR1;
    volatile uint32_t OAR2;
    volatile uint32_t DR;
    volatile uint32_t SR1;
    volatile uint32_t SR2;
    volatile uint32_t CCR;
    volatile uint32_t TRISE;
} I2C_RegDef_t;

#define GPIOB ((GPIO_RegDef_t_I2C*)GPIOB_BASEADDR)
#define I2C1  ((I2C_RegDef_t*)I2C1_BASEADDR)

// Clock Enables
#define GPIOB_CLK_EN() (RCC->AHB1ENR |= (1 << 1))
#define I2C1_EN()      (RCC->APB1ENR |= (1 << 21))

// Prototypes
void I2C1_Init(void);
void I2C1_Write(uint8_t addr, uint8_t reg, uint8_t data);
void I2C1_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* data, uint16_t count);

#endif
