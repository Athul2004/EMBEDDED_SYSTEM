#include "i2c.h"

void I2C1_Init(void) {
    I2C1_EN();
    GPIOB_EN();

    // PB8(SCL), PB9(SDA) -> AF4, Open Drain
    GPIOB->MODER |= (2 << 16) | (2 << 18);
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);
    GPIOB->OSPEEDR |= (3 << 16) | (3 << 18);
    GPIOB->AFRH |= (4 << 0) | (4 << 4);

    // 100kHz Standard Mode
    I2C1->CR1 |= (1 << 15); // Software Reset
    I2C1->CR1 &= ~(1 << 15);
    I2C1->CR2 = 16;         // 16MHz PCLK
    I2C1->CCR = 80;
    I2C1->TRISE = 17;
    I2C1->CR1 |= 1;         // Enable PE
}

void I2C1_Write(uint8_t addr, uint8_t reg, uint8_t data) {
    uint8_t tmp = data;
    I2C1_WriteMulti(addr, reg, &tmp, 1);
}

void I2C1_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* data, uint16_t count) {
    while(I2C1->SR2 & 2);
    I2C1->CR1 |= (1 << 8); // Start
    while(!(I2C1->SR1 & 1));
    I2C1->DR = addr;
    while(!(I2C1->SR1 & 2));
    (void)I2C1->SR2;

    while(!(I2C1->SR1 & (1 << 7)));
    I2C1->DR = reg;

    for(uint16_t i=0; i<count; i++) {
        while(!(I2C1->SR1 & (1 << 7)));
        I2C1->DR = data[i];
    }

    while(!(I2C1->SR1 & (1 << 7)));
    while(I2C1->SR1 & (1 << 2));
    I2C1->CR1 |= (1 << 9); // Stop
}
