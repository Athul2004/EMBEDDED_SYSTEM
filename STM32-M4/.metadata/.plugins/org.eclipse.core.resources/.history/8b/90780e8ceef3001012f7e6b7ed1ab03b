#ifndef DMA_H_
#define DMA_H_

#include "stm32_f446xx.h"

#define DMA2_BASEADDR 0x40026400U

typedef struct {
    volatile uint32_t CR;
    volatile uint32_t NDTR;
    volatile uint32_t PAR;
    volatile uint32_t M0AR;
    volatile uint32_t M1AR;
    volatile uint32_t FCR;
} DMA_Stream_RegDef_t;

typedef struct {
    volatile uint32_t LISR;
    volatile uint32_t HISR;
    volatile uint32_t LIFCR;
    volatile uint32_t HIFCR;
} DMA_RegDef_t;

#define DMA2         ((DMA_RegDef_t*)DMA2_BASEADDR)
#define DMA2_Stream0 ((DMA_Stream_RegDef_t*)(DMA2_BASEADDR + 0x10))

// Clock Enable (AHB1 Bit 22)
#define DMA2_CLK_EN() (RCC->AHB1ENR |= (1 << 22))

// Prototypes
void DMA2_Init(uint32_t* buffer, uint16_t size);

#endif
