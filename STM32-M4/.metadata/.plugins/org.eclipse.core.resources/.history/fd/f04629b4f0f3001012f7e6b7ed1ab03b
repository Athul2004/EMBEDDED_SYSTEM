#include "dma.h"

// Note: Using DMA2 Stream 0 (Channel 0) for ADC1
void DMA2_Init(uint32_t* buffer, uint16_t size) {
    // 1. Enable DMA2 Clock
    DMA2_CLK_EN();

    // 2. Disable Stream before config
    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);

    // 3. Set Addresses
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)buffer;
    DMA2_Stream0->NDTR = size;

    // 4. Configure Control Register
    // CHSEL=0 (Channel 0), MSIZE=32bit (2), PSIZE=32bit (2)
    // MINC=1 (Memory Increment), CIRC=1 (Circular Mode), DIR=0 (Peripheral to Memory)
    // TCIE=1 (Transfer Complete IRQ), HTIE=1 (Half Transfer IRQ)
    DMA2_Stream0->CR = (0 << 25) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);

    // 5. Enable Stream
    DMA2_Stream0->CR |= 1;
}
