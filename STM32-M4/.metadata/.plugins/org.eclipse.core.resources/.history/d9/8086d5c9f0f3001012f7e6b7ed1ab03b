#include "ssd1306.h"
#include "i2c.h"
#include <string.h>

#define ADDR 0x78 // 0x3C << 1
uint8_t Buffer[1024];
uint8_t cursor_x=0, cursor_y=0;

// Simple Font (Restoring Space, V, A, W, P, F, ., %, :)
const uint8_t Font[][5] = {
    {0x3E,0x51,0x49,0x45,0x3E}, // 0
    {0x00,0x42,0x7F,0x40,0x00}, // 1
    {0x42,0x61,0x51,0x49,0x46}, // 2
    {0x21,0x41,0x45,0x4B,0x31}, // 3
    {0x18,0x14,0x12,0x7F,0x10}, // 4
    {0x27,0x45,0x45,0x45,0x39}, // 5
    {0x3C,0x4A,0x49,0x49,0x30}, // 6
    {0x01,0x71,0x09,0x05,0x03}, // 7
    {0x36,0x49,0x49,0x49,0x36}, // 8
    {0x06,0x49,0x49,0x29,0x1E}, // 9
    {0x00,0x00,0x00,0x00,0x00}, // Space (10)
    {0x1F,0x20,0x40,0x20,0x1F}, // V (11)
    {0x7E,0x09,0x09,0x09,0x7E}, // A (12)
    {0x3F,0x40,0x38,0x40,0x3F}, // W (13)
    {0x7F,0x09,0x09,0x09,0x06}, // P (14)
    {0x7F,0x09,0x09,0x09,0x01}, // F (15)
    {0x00,0x60,0x60,0x00,0x00}, // . (16)
    {0x22,0x14,0x08,0x14,0x22}, // % (17)
    {0x36,0x36,0x00,0x00,0x00}  // : (18)
};

void SSD1306_Init(void) {
    uint8_t cmds[] = { 0xAE,0x20,0x10,0xB0,0xC8,0x00,0x10,0x40,0x81,0xFF,0xA1,0xA6,0xA8,0x3F,0xA4,0xD3,0x00,0xD5,0xF0,0xD9,0x22,0xDA,0x12,0xDB,0x20,0x8D,0x14,0xAF };
    for(int i=0; i<sizeof(cmds); i++) I2C1_Write(ADDR, 0x00, cmds[i]);
}

void SSD1306_Clear(void) { memset(Buffer, 0, 1024); }

void SSD1306_Update(void) {
    for(int i=0; i<8; i++) {
        I2C1_Write(ADDR, 0x00, 0xB0+i);
        I2C1_Write(ADDR, 0x00, 0x00);
        I2C1_Write(ADDR, 0x00, 0x10);
        I2C1_WriteMulti(ADDR, 0x40, &Buffer[128*i], 128);
    }
}

void SSD1306_SetCursor(uint8_t x, uint8_t y) { cursor_x = x; cursor_y = y; }

void SSD1306_DrawChar(char ch) {
    int idx = 10; // Default to space
    if (ch >= '0' && ch <= '9') idx = ch - '0';
    else if (ch == 'V') idx = 11; else if (ch == 'A') idx = 12; else if (ch == 'W') idx = 13;
    else if (ch == 'P') idx = 14; else if (ch == 'F') idx = 15; else if (ch == '.') idx = 16;
    else if (ch == '%') idx = 17; else if (ch == ':') idx = 18;

    if(cursor_x > 120) return;

    for (int i=0; i<5; i++) Buffer[cursor_x++ + (cursor_y*128)] = Font[idx][i];
    cursor_x++;
}

void SSD1306_Print(char* str) { while (*str) SSD1306_DrawChar(*str++); }

void SSD1306_PrintNumber(int num) {
    char buf[10]; int i=0;
    if(num==0) { SSD1306_Print("0"); return; }
    while(num>0) { buf[i++]=(num%10)+'0'; num/=10; }
    while(--i>=0) SSD1306_DrawChar(buf[i]);
}
