// ====================================================
//                    MAIN FUNCTION
// ====================================================
int main(void) {
    FPU_CPACR |= (0xF << 20); // Enable FPU

    Hardware_Init();
    SSD1306_Init();

    // --- BOOT SCREEN ---
    SSD1306_Clear();
    SSD1306_PrintCentered(2, "SMART METER");
    SSD1306_PrintCentered(4, "INITIALIZING");
    SSD1306_Update();

    UART2_SendString("System Online.\r\n");

    while(1) {
        if (DMA2->LISR & (1 << 4)) {
            DMA2->LIFCR |= (1 << 4);
            Accumulate_Data(0);
        }
        if (DMA2->LISR & (1 << 5)) {
            DMA2->LIFCR |= (1 << 5);
            Accumulate_Data(BUF_LEN / 2);
        }
    }
}

// ====================================================
//                  ADVANCED DSP ENGINE
// ====================================================
void Accumulate_Data(int start_index) {
    static uint64_t acc_v_sq = 0;
    static uint64_t acc_i_sq = 0;
    static float acc_p_inst = 0;
    static int sample_count = 0;

    // For Frequency Calc
    static int last_v_sign = 0;
    static int zero_crossings = 0;

    int limit = start_index + (BUF_LEN / 2);

    for(int n = start_index; n < limit; n += 2) {
        int32_t v = (int32_t)adc_buffer[n] - V_OFFSET;
        int32_t i = (int32_t)adc_buffer[n+1] - I_OFFSET;

        acc_v_sq += (v * v);
        acc_i_sq += (i * i);
        acc_p_inst += (float)(-(v * i));

        // Frequency Counter
        int current_sign = (v > 0) ? 1 : -1;
        if(current_sign != last_v_sign && last_v_sign != 0) {
            zero_crossings++;
        }
        last_v_sign = current_sign;

        sample_count++;
    }

    if (sample_count >= 8000) {
        // --- 1. CALCULATIONS ---
        float v_rms = sqrtf((float)acc_v_sq / sample_count) * v_cal;
        float i_rms = sqrtf((float)acc_i_sq / sample_count) * i_cal;

        if (v_rms < 15.0f) v_rms = 0.0f;
        if (i_rms < 0.05f) i_rms = 0.0f;

        float active_power = (acc_p_inst / sample_count) * v_cal * i_cal;
        if (i_rms == 0.0f) active_power = 0.0f;
        if (active_power < 0) active_power = -active_power;

        float apparent_power = v_rms * i_rms;
        float pf = 0.0f;
        if (apparent_power > 0.5f) pf = (active_power / apparent_power) * 100.0f;
        if (pf > 100.0f) pf = 100.0f;

        float frequency = (float)zero_crossings / 2.0f;

        // --- 2. FORMATTED DISPLAY STRINGS ---
        char line_buf[22]; // Buffer for text formatting

        SSD1306_Clear();

        // -- ROW 0: HEADER --
        SSD1306_PrintCentered(0, "--- STATUS ---");

        // -- ROW 2: VOLTAGE & CURRENT --
        // Format: "230V  |  0.45A"
        // Manually building string since we don't have full sprintf float support
        int v_int = (int)v_rms;
        int i_int = (int)i_rms;
        int i_dec = (int)((i_rms - i_int) * 100);

        SSD1306_SetCursor(10, 2); // Left Align with padding
        SSD1306_PrintNumber(v_int); SSD1306_Print("V");
        SSD1306_SetCursor(75, 2); // Right side
        SSD1306_PrintNumber(i_int); SSD1306_Print(".");
        if(i_dec<10) SSD1306_Print("0"); // Leading zero for decimal
        SSD1306_PrintNumber(i_dec); SSD1306_Print("A");

        // -- ROW 4: POWER (CENTERED & BOLD-ISH) --
        int p_int = (int)active_power;
        // Hacky string construction
        SSD1306_SetCursor(0, 4); // Clear line
        // We calculate center manually: 128 width. "100 W" is 5 chars * 6px = 30px.
        // X = (128-30)/2 = 49.
        int p_width = (p_int > 99) ? 3 : (p_int > 9) ? 2 : 1;
        int x_pos = (128 - ((p_width + 2) * 6)) / 2;

        SSD1306_SetCursor(x_pos, 4);
        SSD1306_PrintNumber(p_int); SSD1306_Print(" W");

        // -- ROW 6: PF & FREQ --
        int pf_int = (int)pf;
        int f_int = (int)frequency;

        SSD1306_SetCursor(5, 6);
        SSD1306_Print("PF:"); SSD1306_PrintNumber(pf_int);
        SSD1306_SetCursor(70, 6);
        SSD1306_Print("Hz:"); SSD1306_PrintNumber(f_int);

        SSD1306_Update();

        // --- 3. UART DUMP ---
        UART2_SendString("\r\nUpdate:\r\n");
        UART2_SendString("V: "); UART2_SendNumber(v_int);
        UART2_SendString(" | I: "); UART2_SendNumber(i_int); UART2_SendString("."); UART2_SendNumber(i_dec);
        UART2_SendString(" | P: "); UART2_SendNumber(p_int);
        UART2_SendString("\r\n");

        acc_v_sq = 0; acc_i_sq = 0; acc_p_inst = 0; sample_count = 0;
        zero_crossings = 0;
    }
}

// ====================================================
//                  DRIVER IMPLEMENTATIONS
// ====================================================

void Hardware_Init(void) {
    // 1. Clocks
    ENABLE_DMA2(); ENABLE_ADC1(); ENABLE_TIM2(); ENABLE_GPIOA();
    RCC->AHB1ENR |= (1<<1); // GPIOB Enable
    RCC->APB1ENR |= (1<<21); // I2C1 Enable
    ENABLE_UART2();

    // 2. GPIOA (ADC)
    GPIOA->MODER |= (3 << 0) | (3 << 2);

    // 3. GPIOA (UART)
    GPIOA->MODER |= (2 << 4) | (2 << 6);
    GPIOA->AFRL  |= (7 << 8) | (7 << 12);

    // 4. GPIOB (I2C)
    GPIOB->MODER |= (2 << 16) | (2 << 18);
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);
    GPIOB->OSPEEDR |= (3 << 16) | (3 << 18);
    GPIOB->AFRH |= (4 << 0) | (4 << 4);

    // 5. UART
    USART2->BRR = 0x008B;
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);

    // 6. I2C
    I2C1->CR1 |= (1 << 15); I2C1->CR1 &= ~(1 << 15);
    I2C1->CR2 = 16; I2C1->CCR = 80; I2C1->TRISE = 17; I2C1->CR1 |= 1;

    // 7. ADC
    ADC1->CR1 |= (1 << 8);
    ADC1->CR2 |= (1 << 8) | (1 << 9) | (6 << 24) | (1 << 28);
    ADC1->SQR1 = (1 << 20);
    ADC1->SQR3 = (0 << 0) | (1 << 5);
    ADC1->CR2 |= 1;

    // 8. DMA
    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream0->NDTR = BUF_LEN;
    DMA2_Stream0->CR = (0 << 25) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1;

    // 9. Timer
    TIM2->PSC = 0;
    TIM2->ARR = 1999;
    TIM2->CR2 |= (2 << 4);
    TIM2->CR1 |= 1;
}

// --- UART ---
void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = *string++;
    }
}
void UART2_SendNumber(int number) {
    char buf[12]; int i=0;
    if(number==0) { UART2_SendString("0"); return; }
    if(number<0) { UART2_SendString("-"); number=-number; }
    while(number>0) { buf[i++]=(number%10)+'0'; number/=10; }
    while(--i>=0) { while(!(USART2->SR & (1<<7))); USART2->DR=buf[i]; }
}

// --- I2C (Fixed Indentation) ---
void I2C1_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* d, uint16_t c) {
    while(I2C1->SR2 & 2);
    I2C1->CR1 |= (1 << 8);
    while(!(I2C1->SR1 & 1));
    I2C1->DR = addr;
    while(!(I2C1->SR1 & 2));
    (void)I2C1->SR2;
    while(!(I2C1->SR1 & (1<<7)));
    I2C1->DR = reg;
    for(uint16_t i=0; i<c; i++) {
        while(!(I2C1->SR1 & (1<<7)));
        I2C1->DR = d[i];
    }
    while(!(I2C1->SR1 & (1<<7)));
    while(I2C1->SR1 & (1<<2));
    I2C1->CR1 |= (1 << 9);
}

void I2C1_Write(uint8_t addr, uint8_t reg, uint8_t data) {
    uint8_t tmp = data;
    I2C1_WriteMulti(addr, reg, &tmp, 1);
}

// --- OLED ---
#define SSD1306_ADDR 0x78

void SSD1306_Init(void) {
    uint8_t cmds[] = { 0xAE,0x20,0x10,0xB0,0xC8,0x00,0x10,0x40,0x81,0xFF,0xA1,0xA6,0xA8,0x3F,0xA4,0xD3,0x00,0xD5,0xF0,0xD9,0x22,0xDA,0x12,0xDB,0x20,0x8D,0x14,0xAF };
    for(int i=0; i<sizeof(cmds); i++) I2C1_Write(SSD1306_ADDR, 0x00, cmds[i]);
}

void SSD1306_Clear(void) {
    memset(OLED_Buffer, 0, 1024);
}

void SSD1306_Update(void) {
    for(int i=0; i<8; i++) {
        I2C1_Write(SSD1306_ADDR, 0x00, 0xB0+i);
        I2C1_Write(SSD1306_ADDR, 0x00, 0x00);
        I2C1_Write(SSD1306_ADDR, 0x00, 0x10);
        I2C1_WriteMulti(SSD1306_ADDR, 0x40, &OLED_Buffer[128*i], 128);
    }
}

void SSD1306_SetCursor(uint8_t x, uint8_t y) {
    cursor_x = x;
    cursor_y = y;
}

void SSD1306_DrawChar(char ch) {
    int idx = 10;
    if (ch >= '0' && ch <= '9') idx = ch - '0';
    else if (ch == 'V') idx = 11; else if (ch == 'A') idx = 12; else if (ch == 'W') idx = 13;
    else if (ch == 'P') idx = 14; else if (ch == 'F') idx = 15; else if (ch == '.') idx = 16;
    else if (ch == '%') idx = 17; else if (ch == ':') idx = 18;
    else if (ch == '-') idx = 10; // Treat dash as space/blank for now if not in font
    else if (ch == ' ') idx = 10;

    if (cursor_x < 122) {
        for (int i=0; i<5; i++) OLED_Buffer[cursor_x++ + (cursor_y*128)] = Font[idx][i];
        cursor_x++;
    }
}

void SSD1306_Print(char* str) {
    while (*str) SSD1306_DrawChar(*str++);
}

void SSD1306_PrintNumber(int num) {
    char buf[10]; int i=0;
    if(num==0) { SSD1306_Print("0"); return; }
    while(num>0) { buf[i++]=(num%10)+'0'; num/=10; }
    while(--i>=0) SSD1306_DrawChar(buf[i]);
}

void SSD1306_PrintCentered(uint8_t y, char* str) {
    int len = 0;
    char* p = str;
    while(*p++) len++; // Calculate length

    int x_pos = (128 - (len * 6)) / 2; // (Screen Width - Text Width) / 2
    if (x_pos < 0) x_pos = 0;

    SSD1306_SetCursor((uint8_t)x_pos, y);
    SSD1306_Print(str);
}
