// ====================================================
//                    MAIN FUNCTION
// ====================================================
int main(void) {
    FPU_CPACR |= (0xF << 20); // Enable FPU

    System_Init_All();

    SSD1306_Init();
    SSD1306_Clear();
    SSD1306_SetCursor(10, 2);
    SSD1306_Print("SYSTEM READY");
    SSD1306_Update();

    UART2_SendString("System Running.\r\n");

    while(1) {
        if (DMA2->LISR & (1 << 4)) {
            DMA2->LIFCR |= (1 << 4);
            Accumulate_Data(0);
        }
        if (DMA2->LISR & (1 << 5)) {
            DMA2->LIFCR |= (1 << 5);
            Accumulate_Data(BUF_LEN / 2);
        }
    }
}

// ====================================================
//                  ADVANCED DSP ENGINE
// ====================================================
void Accumulate_Data(int start_index) {
    static uint64_t acc_v_sq = 0;
    static uint64_t acc_i_sq = 0;
    static float acc_p_inst = 0;
    static int sample_count = 0;

    static int v_peak_max = 0;
    static int i_peak_max = 0;
    static int last_v_sign = 0;
    static int zero_crossings = 0;

    int limit = start_index + (BUF_LEN / 2);

    for(int n = start_index; n < limit; n += 2) {
        int32_t v = (int32_t)adc_buffer[n] - V_OFFSET;
        int32_t i = (int32_t)adc_buffer[n+1] - I_OFFSET;

        acc_v_sq += (v * v);
        acc_i_sq += (i * i);
        acc_p_inst += (float)(-(v * i));

        if(v < 0) v = -v;
        if(i < 0) i = -i;
        if(v > v_peak_max) v_peak_max = v;
        if(i > i_peak_max) i_peak_max = i;

        int current_sign = ((int32_t)adc_buffer[n] - V_OFFSET) > 0 ? 1 : -1;
        if(current_sign != last_v_sign && last_v_sign != 0) {
            zero_crossings++;
        }
        last_v_sign = current_sign;

        sample_count++;
    }

    if (sample_count >= 8000) {
        float v_rms = sqrtf((float)acc_v_sq / sample_count) * v_cal;
        float i_rms = sqrtf((float)acc_i_sq / sample_count) * i_cal;

        if (v_rms < 15.0f) v_rms = 0.0f;
        if (i_rms < 0.05f) i_rms = 0.0f;

        float active_power = (acc_p_inst / sample_count) * v_cal * i_cal;
        if (i_rms == 0.0f) active_power = 0.0f;
        if (active_power < 0) active_power = -active_power;

        float apparent_power = v_rms * i_rms;
        float reactive_power = 0;
        if(apparent_power > active_power) {
            reactive_power = sqrtf((apparent_power*apparent_power) - (active_power*active_power));
        }

        float pf = 0.0f;
        if (apparent_power > 0.5f) {
            pf = (active_power / apparent_power) * 100.0f;
            if (pf > 100.0f) pf = 100.0f;
        }

        float frequency = (float)zero_crossings / 2.0f;
        float v_peak = (float)v_peak_max * v_cal;
        // i_peak removed to fix warning

        SSD1306_Clear();
        SSD1306_SetCursor(0, 0); SSD1306_Print("V: "); SSD1306_PrintNumber((int)v_rms);
        SSD1306_SetCursor(0, 2); SSD1306_Print("A: "); SSD1306_PrintNumber((int)i_rms);
        SSD1306_SetCursor(0, 4); SSD1306_Print("W: "); SSD1306_PrintNumber((int)active_power);
        SSD1306_SetCursor(0, 6); SSD1306_Print("PF:"); SSD1306_PrintNumber((int)pf);
        SSD1306_Update();

        UART2_SendString("\r\n--- METRICS ---\r\n");
        UART2_SendString("V(rms): "); UART2_SendNumber((int)v_rms);
        UART2_SendString(" I(rms): "); UART2_SendNumber((int)(i_rms*1000));
        UART2_SendString(" P(act): "); UART2_SendNumber((int)active_power);
        UART2_SendString("\r\nQ(rea): "); UART2_SendNumber((int)reactive_power);
        UART2_SendString(" Freq: "); UART2_SendNumber((int)frequency);
        UART2_SendString(" Vpeak: "); UART2_SendNumber((int)v_peak);
        UART2_SendString("\r\n");

        acc_v_sq = 0; acc_i_sq = 0; acc_p_inst = 0; sample_count = 0;
        v_peak_max = 0; i_peak_max = 0; zero_crossings = 0;
    }
}

// ====================================================
//                  DRIVER IMPLEMENTATIONS
// ====================================================

void HW_Init(void) {
    ENABLE_DMA2(); ENABLE_ADC1(); ENABLE_TIM2(); ENABLE_GPIOA();

    GPIOA->MODER |= (3 << 0) | (3 << 2);

    ADC1->CR1 |= (1 << 8);
    ADC1->CR2 |= (1 << 8) | (1 << 9) | (6 << 24) | (1 << 28);
    ADC1->SQR1 = (1 << 20);
    ADC1->SQR3 = (0 << 0) | (1 << 5);
    ADC1->CR2 |= 1;

    DMA2_Stream0->CR &= ~1;
    while(DMA2_Stream0->CR & 1);
    DMA2_Stream0->PAR = (uint32_t)&ADC1->DR;
    DMA2_Stream0->M0AR = (uint32_t)adc_buffer;
    DMA2_Stream0->NDTR = BUF_LEN;
    DMA2_Stream0->CR = (0 << 25) | (2 << 13) | (2 << 11) | (1 << 10) | (1 << 8);
    DMA2_Stream0->CR |= 1;

    TIM2->PSC = 0;
    TIM2->ARR = 1999;
    TIM2->CR2 |= (2 << 4);
    TIM2->CR1 |= 1;
}

void UART_Init(void) {
    ENABLE_GPIOA(); ENABLE_UART2();
    GPIOA->MODER |= (2 << 4) | (2 << 6);
    GPIOA->AFRL  |= (7 << 8) | (7 << 12);
    USART2->BRR = 0x008B;
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART_Send(char *s) {
    while(*s) { while (!(USART2->SR & (1 << 7))); USART2->DR = *s++; }
}

void UART_Num(int n) {
    char b[12]; int i=0;
    if(n==0) { UART_Send("0"); return; }
    if(n < 0) { UART_Send("-"); n = -n; }
    while(n > 0) { b[i++]=(n%10)+'0'; n/=10; }
    while(--i>=0) { while(!(USART2->SR & (1<<7))); USART2->DR=b[i]; }
}

void I2C_Init(void) {
    ENABLE_GPIOB(); ENABLE_I2C1();
    GPIOB->MODER |= (2 << 16) | (2 << 18);
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);
    GPIOB->OSPEEDR |= (3 << 16) | (3 << 18);
    GPIOB->AFRH |= (4 << 0) | (4 << 4);
    I2C1->CR1 |= (1 << 15); I2C1->CR1 &= ~(1 << 15);
    I2C1->CR2 = 16; I2C1->CCR = 80; I2C1->TRISE = 17; I2C1->CR1 |= 1;
}

void I2C_WriteMulti(uint8_t addr, uint8_t reg, uint8_t* d, uint16_t c) {
    while(I2C1->SR2 & 2); I2C1->CR1 |= (1 << 8);
    while(!(I2C1->SR1 & 1)); I2C1->DR = addr;
    while(!(I2C1->SR1 & 2)); (void)I2C1->SR2;
    while(!(I2C1->SR1 & (1 << 7))); I2C1->DR = reg;
    for(uint16_t i=0; i<c; i++) { while(!(I2C1->SR1 & (1 << 7))); I2C1->DR = d[i]; }
    while(!(I2C1->SR1 & (1 << 7))); while(I2C1->SR1 & (1 << 2)); I2C1->CR1 |= (1 << 9);
}

void I2C_Write(uint8_t addr, uint8_t reg, uint8_t data) {
    uint8_t tmp = data; I2C_WriteMulti(addr, reg, &tmp, 1);
}

void OLED_Init(void) {
    uint8_t cmds[] = { 0xAE,0x20,0x10,0xB0,0xC8,0x00,0x10,0x40,0x81,0xFF,0xA1,0xA6,0xA8,0x3F,0xA4,0xD3,0x00,0xD5,0xF0,0xD9,0x22,0xDA,0x12,0xDB,0x20,0x8D,0x14,0xAF };
    for(int i=0; i<sizeof(cmds); i++) I2C_Write(SSD1306_ADDR, 0x00, cmds[i]);
}

void OLED_Clear(void) { memset(OLED_Buffer, 0, 1024); }

void OLED_Update(void) {
    for(int i=0; i<8; i++) {
        I2C_Write(SSD1306_ADDR, 0x00, 0xB0+i); I2C_Write(SSD1306_ADDR, 0x00, 0x00);
        I2C_Write(SSD1306_ADDR, 0x00, 0x10); I2C_WriteMulti(SSD1306_ADDR, 0x40, &OLED_Buffer[128*i], 128);
    }
}

void OLED_Set(uint8_t x, uint8_t y) { cursor_x = x; cursor_y = y; }

void OLED_DrawChar(char ch) {
    int idx = 10;
    if (ch >= '0' && ch <= '9') idx = ch - '0';
    else if (ch == 'V') idx = 11; else if (ch == 'A') idx = 12; else if (ch == 'W') idx = 13;
    else if (ch == 'P') idx = 14; else if (ch == 'F') idx = 15; else if (ch == '.') idx = 16;
    else if (ch == '%') idx = 17; else if (ch == ':') idx = 18;
    for (int i=0; i<5; i++) OLED_Buffer[cursor_x++ + (cursor_y*128)] = Font[idx][i];
    cursor_x++;
}

void OLED_Str(char* s) { while (*s) OLED_DrawChar(*s++); }

void OLED_Num(int n) {
    char b[10]; int i=0;
    if(n==0) { OLED_Str("0"); return; }
    while(n>0) { b[i++]=(n%10)+'0'; n/=10; }
    while(--i>=0) OLED_DrawChar(b[i]);
}

// --- LINKERS ---
void System_Init_All(void) { UART_Init(); I2C_Init(); HW_Init(); OLED_Init(); }
void UART2_SendString(char *string) { UART_Send(string); }
void UART2_SendNumber(int number) { UART_Num(number); }
void SSD1306_SetCursor(uint8_t x, uint8_t y) { OLED_Set(x, y); }
void SSD1306_Print(char* str) { OLED_Str(str); }
void SSD1306_PrintNumber(int num) { OLED_Num(num); }
