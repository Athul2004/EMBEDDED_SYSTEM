#include "stm32_f446xx.h"
#include <math.h>
#include <stdint.h>

// --- DEFINES ---
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- CALIBRATION: VOLTAGE (PA0) ---
#define V_OFFSET 2065           // Your measured center for ZMPT
float v_calibration = 0.727;    // Your tuned factor

// --- CALIBRATION: CURRENT (PA1) ---
// ACS712 centers at 2.5V (VCC/2).
// On 3.3V ADC: (2.5 / 3.3) * 4096 = ~3103
#define I_OFFSET 3103
float i_calibration = 0.045;    // Start here, then tune with a known load

// --- PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read_Channel(uint8_t channel); // New function to switch channels
float Get_Voltage(void);
float Get_Current(void);

int main(void) {
    // 1. ENABLE FPU
    SCB_CPACR |= (0xF << 20);

    // 2. Initialize
    UART2_Init();
    ADC1_Init();

    UART2_SendString("STM32 Power Meter Active.\r\n");

    while(1) {
        // 3. Measure Both
        float volts = Get_Voltage();
        float amps  = Get_Current();
        float watts = volts * amps;

        // 4. Print Voltage ("240 V")
        UART2_SendString("V: ");
        UART2_SendNumber((int)volts);

        // 5. Print Current ("0.45 A")
        // Manual float printing
        int i_int = (int)amps;
        int i_dec = (int)((amps - i_int) * 100); // 2 decimal places
        UART2_SendString("   I: ");
        UART2_SendNumber(i_int);
        UART2_SendString(".");
        if(i_dec < 10) UART2_SendString("0");
        UART2_SendNumber(i_dec);
        UART2_SendString(" A");

        // 6. Print Power ("100 W")
        UART2_SendString("   P: ");
        UART2_SendNumber((int)watts);
        UART2_SendString(" W\r\n");

        // Delay
        for(volatile uint32_t i = 0; i < 2000000; i++);
    }
}

// --- MEASUREMENT LOGIC ---

float Get_Voltage(void) {
    uint32_t samples = 800;
    uint64_t sum_squares = 0;

    for (int i = 0; i < samples; i++) {
        // Read Channel 0 (PA0)
        int raw = ADC1_Read_Channel(0);
        int val = raw - V_OFFSET;
        sum_squares += (val * val);
        for(volatile int k=0; k<50; k++);
    }

    float rms = sqrt(sum_squares / samples);
    float volts = rms * v_calibration;

    // Voltage Noise Gate
    if (volts < 10.0) return 0.0;
    return volts;
}

float Get_Current(void) {
    uint32_t samples = 800;
    uint64_t sum_squares = 0;

    for (int i = 0; i < samples; i++) {
        // Read Channel 1 (PA1)
        int raw = ADC1_Read_Channel(1);
        int val = raw - I_OFFSET;
        sum_squares += (val * val);
        for(volatile int k=0; k<50; k++);
    }

    float rms = sqrt(sum_squares / samples);
    float amps = rms * i_calibration;

    // Current Noise Gate (ACS712 is noisy!)
    // Ignore anything less than 0.05 Amps (50mA)
    if (amps < 0.05) return 0.0;
    return amps;
}

// --- DRIVERS ---

void ADC1_Init(void) {
    ADC1_EN();
    GPIOA_CLK_EN();

    // Configure PA0 (Voltage) AND PA1 (Current) as Analog Mode (11)
    // Mode Register: Bits [1:0] for PA0, [3:2] for PA1
    GPIOA->MODER |= (3 << 0); // PA0 Analog
    GPIOA->MODER |= (3 << 2); // PA1 Analog

    ADC1->CR2 |= (1 << 0);    // Enable ADC
    for(volatile int i=0; i<1000; i++);
}

uint32_t ADC1_Read_Channel(uint8_t channel) {
    // 1. Select Channel in SQR3 Register
    // Bits 0-4 control the 1st conversion in the sequence
    ADC1->SQR3 &= ~(0x1F); // Clear previous channel
    ADC1->SQR3 |= channel; // Set new channel (0 or 1)

    // 2. Start Conversion
    ADC1->CR2 |= (1 << 30);

    // 3. Wait for EOC (End of Conversion)
    while (!(ADC1->SR & (1 << 1)));

    // 4. Return Result
    return ADC1->DR;
}

void UART2_Init(void) {
    GPIOA_CLK_EN();
    USART2_EN();
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->MODER &= ~(3 << 6); GPIOA->MODER |= (2 << 6);
    GPIOA->AFRL &= ~(0xF << 8); GPIOA->AFRL |= (0x7 << 8);
    USART2->BRR = 0x0683;
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    while (number > 0) { buf[i++] = (number % 10) + '0'; number /= 10; }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
