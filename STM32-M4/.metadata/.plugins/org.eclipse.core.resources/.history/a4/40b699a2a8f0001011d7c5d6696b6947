#include "stm32_f446xx.h"
#include <stdio.h>  // For sprintf
#include <math.h>   // For sqrt

// Function Prototypes
void UART2_Init(void);
void UART2_SendString(char *string);
void ADC1_Init(void);
uint32_t ADC1_Read(void);
float Calculate_RMS(void);

// Global Buffer for printing
char msg[50];

int main(void) {
    // 1. Initialize Peripherals
    UART2_Init();
    ADC1_Init();

    UART2_SendString("ZMPT101B Energy Monitor Started...\r\n");

    while(1) {
        // 2. Calculate RMS Voltage
        float rms_voltage = Calculate_RMS();

        // 3. Print to PuTTY
        // Note: float printing can be tricky in bare metal.
        // We cast to integer parts for display: "230.50 V"
        int val_int = (int)rms_voltage;
        int val_dec = (int)((rms_voltage - val_int) * 100);

        sprintf(msg, "Voltage: %d.%02d V\r\n", val_int, val_dec);
        UART2_SendString(msg);

        // Delay 1 second
        for(uint32_t i = 0; i < 5000000; i++);
    }
}

// --- ADC Functions ---

void ADC1_Init(void) {
    // 1. Enable Clocks for ADC1 and GPIOA
    ADC1_EN();
    GPIOA_CLK_EN();

    // 2. Configure PA0 as Analog Mode (11)
    GPIOA->MODER |= (3 << 0); // Set PA0 bits 0-1 to '11'

    // 3. Configure ADC Sequence Length (1 conversion)
    // SQR1 bits 20-23 = 0000 (1 conversion) - Default is 0, so no change needed.

    // 4. Configure ADC Sequence (Select Channel 0 as 1st conversion)
    // SQR3 bits 0-4 = 0 (Channel 0) - Default is 0.

    // 5. Turn On ADC (ADON)
    ADC1->CR2 |= (1 << 0);
}

uint32_t ADC1_Read(void) {
    // 1. Start Conversion (SWSTART)
    ADC1->CR2 |= (1 << 30);

    // 2. Wait for conversion to complete (EOC bit in SR)
    while (!(ADC1->SR & (1 << 1)));

    // 3. Read Data Register (Clears EOC)
    return ADC1->DR;
}

// --- Measurement Logic ---

float Calculate_RMS(void) {
    uint32_t samples = 0;
    uint32_t num_samples = 1000; // Take 1000 readings
    double sum_squares = 0;

    // ZMPT101B Zero Point (VCC/2)
    // For 3.3V ADC (12-bit = 4096), midpoint is ~2048
    int offset = 2048;

    for (int i = 0; i < num_samples; i++) {
        int reading = ADC1_Read();
        int value = reading - offset; // Center the wave around 0
        sum_squares += (value * value);

        // Small delay to span across the AC wave (50Hz = 20ms)
        // 1000 samples loops run very fast, this delay helps spread them out
        for(int k=0; k<200; k++);
    }

    // RMS Formula: Sqrt(Sum / N)
    float rms_raw = sqrt(sum_squares / num_samples);

    // CALIBRATION: Convert Raw ADC RMS to Actual Voltage
    // You must adjust this value using a multimeter!
    // Example: If Multimeter says 230V and Code says 150 (raw),
    // Factor = 230 / 150 = 1.53.
    float calibration_factor = 0.55;

    return rms_raw * calibration_factor;
}

// --- UART Functions (Reused) ---

void UART2_Init(void) {
    USART2_EN();
    GPIOA_CLK_EN();
    GPIOA->MODER &= ~(3 << 4);
    GPIOA->MODER |=  (2 << 4);
    GPIOA->AFRL &= ~(0xF << 8);
    GPIOA->AFRL |=  (0x7 << 8);
    USART2->BRR = 0x0683; // 9600 baud
    USART2->CR1 = (1 << 13) | (1 << 3);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}
