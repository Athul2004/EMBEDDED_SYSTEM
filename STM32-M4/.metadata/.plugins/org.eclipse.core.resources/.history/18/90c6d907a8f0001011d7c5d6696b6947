#include "stm32_f446xx.h"

void UART2_Init(void);
void UART2_Write(int ch);
void print_hello(char *msg);

int main(void) {
    UART2_Init();

    while(1) {
        print_hello("Hello World from energy !\r\n");
        // Simple delay loop
        for(uint32_t i = 0; i < 500000; i++);
    }
}

void UART2_Init(void) {
    // 1. Enable Clocks
    GPIOA_CLK_EN();
    USART2_EN();

    // 2. Configure PA2 (TX) and PA3 (RX) as Alternate Function
    // PA2: Clear bits 4-5, set to 10 (AF)
    GPIOA->MODER &= ~(3 << 4);
    GPIOA->MODER |=  (2 << 4);
    // PA3: Clear bits 6-7, set to 10 (AF)
    GPIOA->MODER &= ~(3 << 6);
    GPIOA->MODER |=  (2 << 6);

    // 3. Set Alternate Function Type to AF7 (USART2)
    // Accessing AFRL because we defined it in the struct
    GPIOA->AFRL &= ~(0xFF << 8);   // Clear PA2 and PA3 slots
    GPIOA->AFRL |=  (0x77 << 8);   // Set both to AF7

    // 4. Configure Baudrate
    USART2->BRR = 0x0683;

    // 5. Enable UART (UE) and Transmitter (TE)
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_Write(int ch) {
    while (!(USART2->SR & (1 << 7)));
    USART2->DR = (ch & 0xFF);
}

void print_hello(char *msg) {
    while(*msg) {
        UART2_Write(*msg++);
    }
}
