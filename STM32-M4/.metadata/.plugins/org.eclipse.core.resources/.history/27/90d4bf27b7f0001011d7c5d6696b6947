#include "stm32_f446xx.h"
#include <math.h>

// --- DEFINES ---
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read(void);
float Calculate_RMS(void);

// Global Calibration Factor
// YOU MUST TUNE THIS: Compare PuTTY value with a real Multimeter!
// Formula: NewFactor = (RealMultimeterVolts / PuTTYVolts) * OldFactor
float calibration_factor = 0.645;

int main(void) {
    // 1. ENABLE FPU
    SCB_CPACR |= (0xF << 20);

    // 2. Initialize
    UART2_Init();
    ADC1_Init();

    UART2_SendString("ZMPT101B Active. Connect AC Mains now.\r\n");

    while(1) {
        // 3. Measure
        float voltage = Calculate_RMS();

        // 4. Print
        int val_int = (int)voltage;
        int val_dec = (int)((voltage - val_int) * 100);

        UART2_SendString("Voltage: ");
        UART2_SendNumber(val_int);
        UART2_SendString(".");
        UART2_SendNumber(val_dec);
        UART2_SendString(" V\r\n");

        // Delay 1 second
        for(volatile uint32_t i = 0; i < 2000000; i++);
    }
}

float Calculate_RMS(void) {
    uint32_t num_samples = 1000;
    uint32_t buffer[1000];
    uint64_t sum_squares = 0;

    // YOUR MEASURED CENTER POINT
    // Based on your logs (Min 2020, Max 2100), the average is ~2065.
    int dc_offset = 2065;

    // 1. Capture Samples
    for (int i = 0; i < num_samples; i++) {
        buffer[i] = ADC1_Read();
        // Short delay to spread samples over the AC wave
        for(volatile int k=0; k<100; k++);
    }

    // 2. Calculate RMS
    for (int i = 0; i < num_samples; i++) {
        // Remove the 1.65V DC offset to get just the AC swing
        int ac_component = buffer[i] - dc_offset;
        sum_squares += (ac_component * ac_component);
    }

    float rms_raw = sqrt(sum_squares / num_samples);

    // 3. Noise Gate (Ignore tiny ghost voltages < 3V)
    // Since your noise range is ~80 raw, that's roughly 2-3 Volts of noise.
    // We set cutoff to 4.0 to silence it.
    if (rms_raw < 4.0) return 0.0;

    return rms_raw * calibration_factor;
}

// --- DRIVERS (Copying your working drivers) ---

void ADC1_Init(void) {
    ADC1_EN();
    GPIOA_CLK_EN();
    GPIOA->MODER |= (3 << 0);
    ADC1->CR2 |= (1 << 0);
    for(volatile int i=0; i<1000; i++);
}

uint32_t ADC1_Read(void) {
    ADC1->CR2 |= (1 << 30);
    while (!(ADC1->SR & (1 << 1)));
    return ADC1->DR;
}

void UART2_Init(void) {
    GPIOA_CLK_EN();
    USART2_EN();
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->MODER &= ~(3 << 6); GPIOA->MODER |= (2 << 6);
    GPIOA->AFRL &= ~(0xF << 8); GPIOA->AFRL |= (0x7 << 8);
    USART2->BRR = 0x0683;
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    while (number > 0) { buf[i++] = (number % 10) + '0'; number /= 10; }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
