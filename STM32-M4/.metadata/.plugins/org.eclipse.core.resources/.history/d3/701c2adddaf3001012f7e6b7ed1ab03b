#include "stm32_f446xx.h"
#include <math.h>
#include <stdint.h>

// --- DEFINES ---
#define SCB_CPACR (*((volatile uint32_t*)0xE000ED88))

// --- CALIBRATION: CURRENT (PA1) ---
// Based on your debug: Avg was 2045 when powered by 3.3V
#define I_OFFSET 2045
// Calibration factor: Adjust this if the Amps don't match your load
float i_calibration = 0.005;

// --- PROTOTYPES ---
void UART2_Init(void);
void UART2_SendString(char *string);
void UART2_SendNumber(int number);
void ADC1_Init(void);
uint32_t ADC1_Read_PA1(void);
float Get_Current_RMS(void);

int main(void) {
    // 1. Enable Floating Point Unit
    SCB_CPACR |= (0xF << 20);

    // 2. Initialize
    UART2_Init();
    ADC1_Init();

    UART2_SendString("ACS712 Standalone Current Monitor (PA1)\r\n");

    while(1) {
        // 3. Measure Current
        float amps = Get_Current_RMS();

        // 4. Manual Float Print (Format: "Current: 1.25 A")
        int i_int = (int)amps;
        int i_dec = (int)((amps - i_int) * 100);

        UART2_SendString("Current: ");
        UART2_SendNumber(i_int);
        UART2_SendString(".");
        if(i_dec < 10) UART2_SendString("0"); // Leading zero for decimal
        UART2_SendNumber(i_dec);
        UART2_SendString(" A\r\n");

        // Delay ~500ms
        for(volatile uint32_t i = 0; i < 1000000; i++);
    }
}

// --- CURRENT CALCULATION ---

float Get_Current_RMS(void) {
    uint32_t samples = 1000;
    uint64_t sum_squares = 0;

    for (int i = 0; i < samples; i++) {
        // Read PA1 (Channel 1)
        uint32_t raw = ADC1_Read_PA1();

        // Remove the 1.65V (2045) DC offset
        int val = (int)raw - I_OFFSET;

        // Square the result
        sum_squares += (int64_t)val * val;

        // Small delay to capture across the 50Hz/60Hz wave
        for(volatile int k=0; k<50; k++);
    }

    // Root Mean Square math
    float rms = sqrtf((float)sum_squares / (float)samples);

    // Scale to real Amps
    float amps = rms * i_calibration;

    // Noise Gate: Force 0 if below 50mA
    if (amps < 0.05) return 0.0;

    return amps;
}

// --- BARE METAL DRIVERS ---

void ADC1_Init(void) {
    ADC1_EN();          // Enable ADC1 Clock
    GPIOA_CLK_EN();     // Enable GPIOA Clock

    // Configure PA1 as Analog Mode (11)
    GPIOA->MODER |= (3 << 2);

    ADC1->CR2 |= (1 << 0); // ADON: Enable ADC
    for(volatile int i=0; i<1000; i++); // Wait for power up
}

uint32_t ADC1_Read_PA1(void) {
    ADC1->SQR3 = 1;         // Set channel 1 (PA1)
    ADC1->CR2 |= (1 << 30); // SWSTART: Start conversion

    while (!(ADC1->SR & (1 << 1))); // Wait for EOC (End of Conversion)
    return ADC1->DR;        // Return data
}

void UART2_Init(void) {
    GPIOA_CLK_EN();
    USART2_EN();
    // PA2/PA3 to Alt Func
    GPIOA->MODER &= ~(3 << 4); GPIOA->MODER |= (2 << 4);
    GPIOA->MODER &= ~(3 << 6); GPIOA->MODER |= (2 << 6);
    GPIOA->AFRL |= (0x7 << 8) | (0x7 << 12);
    USART2->BRR = 0x0683; // 9600 Baud
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2);
}

void UART2_SendString(char *string) {
    while(*string) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = (*string++ & 0xFF);
    }
}

void UART2_SendNumber(int number) {
    char buf[12];
    int i = 0;
    if (number == 0) { UART2_SendString("0"); return; }
    while (number > 0) { buf[i++] = (number % 10) + '0'; number /= 10; }
    while (--i >= 0) {
        while (!(USART2->SR & (1 << 7)));
        USART2->DR = buf[i];
    }
}
