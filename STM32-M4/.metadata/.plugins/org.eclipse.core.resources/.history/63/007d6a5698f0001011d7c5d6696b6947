void UART2_Init(void) {
    // 1. Enable Clocks
    GPIOA_CLK_EN();
    USART2_EN();

    // 2. Configure PA2 (TX) and PA3 (RX) as Alternate Function
    // We config both PA2 and PA3 even if only using TX, for stability.
    // PA2: Clear bits 4-5, set to 10 (AF)
    GPIOA->MODER &= ~(3 << 4);
    GPIOA->MODER |=  (2 << 4);
    // PA3: Clear bits 6-7, set to 10 (AF)
    GPIOA->MODER &= ~(3 << 6);
    GPIOA->MODER |=  (2 << 6);

    // 3. Set Alternate Function Type to AF7 (USART2)
    // PA2 is in AFRL[11:8], PA3 is in AFRL[15:12]
    GPIOA->AFRL &= ~(0xFF << 8);   // Clear both PA2 and PA3 slots
    GPIOA->AFRL |=  (0x77 << 8);   // Set both to AF7 (0x7)

    // 4. Configure Baudrate (16MHz / (16 * 9600) = 104.1875 -> 104.1875 * 16 = 1667 -> 0x683)
    USART2->BRR = 0x0683;

    // 5. Configure Control Register
    // Enable UART (Bit 13) and Transmitter (Bit 3)
    // It is cleaner to set them in one atomic write operation
    USART2->CR1 = (1 << 13) | (1 << 3) | (1 << 2); // UE | TE | RE (Receiver enabled too)
}

void UART2_Write(int ch) {
    // Wait until Transmit Data Register Empty (TXE) bit is set
    while (!(USART2->SR & (1 << 7)));
    USART2->DR = (ch & 0xFF);
}

void print_hello(char *msg) {
    while(*msg) {
        UART2_Write(*msg++);
    }
}
