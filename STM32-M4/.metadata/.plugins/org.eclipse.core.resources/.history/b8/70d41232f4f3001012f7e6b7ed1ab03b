#ifndef DEVICE_H_
#define DEVICE_H_

// --- STANDARD TYPES ---
// We try to use the system library. If your system is broken,
// we fallback to manual definitions.
#if __has_include(<stdint.h>)
    #include <stdint.h>
#else
    typedef unsigned char      uint8_t;
    typedef unsigned short     uint16_t;
    typedef unsigned long      uint32_t;
    typedef unsigned long long uint64_t;
    typedef signed char        int8_t;
    typedef signed short       int16_t;
    typedef signed long        int32_t;
#endif

// --- HARDWARE BASE ADDRESSES ---
#define RCC_BASE      0x40023800U
#define GPIOA_BASE    0x40020000U
#define GPIOB_BASE    0x40020400U
#define ADC1_BASE     0x40012000U
#define DMA2_BASE     0x40026400U
#define TIM2_BASE     0x40000000U
#define I2C1_BASE     0x40005400U
#define USART2_BASE   0x40004400U
#define FPU_CPACR     (*((volatile uint32_t*)0xE000ED88))

// --- PERIPHERAL STRUCTURES ---
typedef struct {
    volatile uint32_t CR, PLLCFGR, CFGR, CIR, AHB1RSTR, AHB2RSTR, AHB3RSTR, RES0,
                      APB1RSTR, APB2RSTR, RES1[2], AHB1ENR, AHB2ENR, AHB3ENR, RES2,
                      APB1ENR, APB2ENR;
} RCC_TypeDef;

typedef struct {
    volatile uint32_t MODER, OTYPER, OSPEEDR, PUPDR, IDR, ODR, BSRR, LCKR, AFRL, AFRH;
} GPIO_TypeDef;

typedef struct {
    volatile uint32_t CR, NDTR, PAR, M0AR, M1AR, FCR;
} DMA_Stream_TypeDef;

typedef struct {
    volatile uint32_t LISR, HISR, LIFCR, HIFCR;
} DMA_TypeDef;

typedef struct {
    volatile uint32_t SR, CR1, CR2, SMPR1, SMPR2, JOFR1, JOFR2, JOFR3, JOFR4,
                      HTR, LTR, SQR1, SQR2, SQR3, JSQR, JDR1, JDR2, JDR3, JDR4, DR;
} ADC_TypeDef;

typedef struct {
    volatile uint32_t CR1, CR2, SMCR, DIER, SR, EGR, CCMR1, CCMR2, CCER, CNT, PSC, ARR;
} TIM_TypeDef;

typedef struct {
    volatile uint32_t CR1, CR2, OAR1, OAR2, DR, SR1, SR2, CCR, TRISE;
} I2C_TypeDef;

typedef struct {
    volatile uint32_t SR, DR, BRR, CR1, CR2, CR3, GTPR;
} USART_TypeDef;

// --- POINTERS ---
#define RCC          ((RCC_TypeDef*)RCC_BASE)
#define GPIOA        ((GPIO_TypeDef*)GPIOA_BASE)
#define GPIOB        ((GPIO_TypeDef*)GPIOB_BASE)
#define DMA2         ((DMA_TypeDef*)DMA2_BASE)
#define DMA2_Stream0 ((DMA_Stream_TypeDef*)(DMA2_BASE + 0x10))
#define ADC1         ((ADC_TypeDef*)ADC1_BASE)
#define TIM2         ((TIM_TypeDef*)TIM2_BASE)
#define I2C1         ((I2C_TypeDef*)I2C1_BASE)
#define USART2       ((USART_TypeDef*)USART2_BASE)

// --- OLED SETTINGS ---
#define SSD1306_ADDR 0x78

#endif
